    "model": "nvngx_dlssnr.dll",
    "model_distribution": "user-supplied; excluded from builds",
    "placement": "after a successful, identified native DLSS-SR evaluation, before game post-processing and HUD",
    "required_device_extensions": [
      "VK_NVX_binary_import",
      "VK_NVX_image_view_handle",
      "VK_KHR_push_descriptor",
      "VK_KHR_buffer_device_address"
    ],
    "exposure": "explicit white point; no unknown-layout exposure-image access"
  },
  "frame_generation": {
    "backend": "native NVIDIA Streamline Vulkan DLSS-G",
    "initial_display_multiplier": 2,
    "ada_mfg_unlock_included": true,
    "qualification": "Same runtime binary must be verified in both profiles; NR evaluation counters and actual displayed-frame counts are separate evidence."
  },
