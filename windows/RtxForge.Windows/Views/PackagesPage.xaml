<Page
    x:Class="RtxForge.Windows.Views.PackagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:RtxForge.Windows.Views">
    <Page.Resources>
        <Style x:Key="NrPickerGameContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="4,2,4,2"/>
        </Style>
        <DataTemplate x:Key="NrPickerGameTemplate" x:DataType="views:NrPickerGame">
            <Grid ColumnSpacing="12" Padding="8,6,12,6"
                  Background="{x:Bind Highlight, Mode=OneWay, TargetNullValue={ThemeResource CardBackgroundFillColorDefaultBrush}}"
                  PointerEntered="OnNrRowPointerEntered" PointerExited="OnNrRowPointerExited"
                  CornerRadius="{StaticResource ForgeArtCornerRadius}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- The ListViewItem owns focus, hit testing, and accessible selection. -->
                <CheckBox Width="22" MinWidth="0" VerticalAlignment="Center"
                          IsChecked="{x:Bind IsSelected, Mode=OneWay}" IsHitTestVisible="False" IsTabStop="False"
                          AutomationProperties.AccessibilityView="Raw"/>
                <Grid Grid.Column="1" Width="92" Height="43" VerticalAlignment="Center"
                      CornerRadius="{StaticResource ForgeArtCornerRadius}"
                      Background="{ThemeResource ControlFillColorSecondaryBrush}"
                      AutomationProperties.AccessibilityView="Raw">
                    <FontIcon Glyph="&#xE7FC;" FontSize="16" Opacity=".55"/>
                    <Image Source="{x:Bind Artwork}" Stretch="UniformToFill"/>
                    <Border BorderThickness="1" BorderBrush="{x:Bind ArtworkBorder, Mode=OneWay}"
                            CornerRadius="{StaticResource ForgeArtCornerRadius}"/>
                </Grid>
                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{x:Bind Game.Name}" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{x:Bind SelectedInk, Mode=OneWay, TargetNullValue={ThemeResource TextFillColorPrimaryBrush}}"/>
                    <TextBlock Text="{x:Bind Detail}" Visibility="{x:Bind DetailVisibility}"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                               ToolTipService.ToolTip="{x:Bind Detail}"
                               Foreground="{x:Bind SelectedInk, Mode=OneWay, TargetNullValue={ThemeResource TextFillColorSecondaryBrush}}"
                               Style="{StaticResource ForgeCaptionDimTextStyle}"/>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <!-- Built in code (PackagesPage.cs), like the Linux panels it mirrors. -->
</Page>
