body {
    font-family: "Overlay UI";
    font-size: 16dp;
    font-weight: 500;
    color: #282624;
    margin: 0;
    --accent: #c76850;
    --accent-ink: #17457a;
    --accent-soft: #c7685024;
    --muted: #66615b;
}
* { box-sizing: border-box; }
div, section, h1, h2, p { display: block; }
.workspace { position: absolute; left: 44dp; top: 44dp; width: 1000dp; display: flex; align-items: flex-start; gap: 24dp; }
.glass {
    --material-saturation: 0.65;
    --material-luminosity: 0.04;
    --material-texture: 0.018;
    --shadow-opacity: 0.18;
    --shadow-radius: 28;
    --shadow-offset: 12;
    --shadow-blend: adaptive;
    --material-blend: soft-light;
    --material-blend-opacity: .30;
    --surface-tone: .96;
    --surface-grounding: .52;
    background: transparent;
    backdrop-filter: blur(24dp);
    border: 0;
    border-radius: 24dp;
    box-shadow: none;
    flex-shrink: 0;
}
.main-panel { position: relative; width: 520dp; padding: 26dp 32dp 22dp; max-height: 90vh; overflow-y: auto; }
.drag-handle { position: absolute; top: 16dp; left: 24dp; width: 210dp; height: 50dp; cursor: move; z-index: 2; }
.inspector-drag { width: 240dp; }
.brand-row, .section-heading, .field-heading, .footer, .inspector-heading, .inherit-row { display: flex; align-items: center; justify-content: space-between; }
.brand { font-size: 14dp; font-weight: 600; color: #625d57; }
.brand-lockup { display: flex; align-items: center; gap: 10dp; }
.brand-logo { width: 32dp; height: 32dp; }
.window-actions { position: relative; display: flex; align-items: center; gap: 12dp; }
.theme-button { position: relative; padding-right: 26dp; min-width: 84dp; }
.menu { display: none; position: absolute; top: 40dp; right: 36dp; width: 160dp; padding: 6dp; background: #f5f2edf5; border-radius: 12dp; box-shadow: 0dp 8dp 24dp #172a4135; z-index: 10; }
.menu button { display: block; width: 100%; text-align: left; }
.menu button.selected { background-color: var(--accent-soft); }
h1 { font-family: "Bakbak One"; font-size: 28dp; line-height: 1.2; font-weight: 400; margin: 20dp 0 25dp; letter-spacing: -0.5dp; }
h2 { font-family: "Bakbak One"; font-size: 20dp; font-weight: 400; margin: 0; }
button, select { font-family: "Overlay UI"; font-size: 14dp; color: #2e2b28; border: 0; background: transparent; cursor: pointer; }
button { height: 36dp; line-height: 36dp; border-radius: 9dp; padding: 0 12dp; text-align: center; vertical-align: middle; tab-index: auto; transition: background-color .13s cubic-out; }
button:hover { background: #ffffff55; }
button:active { background: #ffffff88; }
button:focus-visible, select:focus-visible, input:focus-visible { box-shadow: 0dp 0dp 0dp 2dp var(--accent); }
button:disabled { opacity: 0.32; cursor: default; }
.quiet { color: #514c46; background: #ffffff20; }
.quiet:hover { background: #ffffff32; }
.quiet:active { background: #ffffff48; }
.quiet:disabled { background: #ffffff10; opacity: .42; }
.close { position: relative; width: 32dp; height: 32dp; padding: 0; }
.close .stroke { position: absolute; display: block; width: 14dp; height: 1.5dp; left: 9dp; top: 15dp; background: #615d58; }
.close .first { transform: rotate(45deg); }
.close .second { transform: rotate(-45deg); }
.preset-row { display: flex; gap: 12dp; align-items: center; }
select { height: 38dp; padding: 9dp 13dp; border-radius: 9dp; background: #ffffff66; border: 1dp #ffffff58; }
select value { display: block; }
select selectbox { background: #f1eee8; padding: 6dp; border-radius: 10dp; box-shadow: 0dp 6dp 20dp #101b2e30; }
select option { padding: 8dp; border-radius: 6dp; }
select option:hover, select option:checked { background-color: var(--accent-soft); }
select selectarrow { display: block; width: 9dp; height: 9dp; border-right: 2dp #514b44; border-bottom: 2dp #514b44; transform: rotate(45deg); margin: 16dp 18dp 0 0; pointer-events: none; }
select selectvalue { padding-right: 28dp; }
.preset-row select { flex: 1; }
.save { color: var(--accent-ink); background: #ffffff80; height: 38dp; font-weight: 600; }
section { margin-top: 29dp; }
.section-heading { margin-bottom: 17dp; }
.switch { position: relative; width: 46dp; height: 27dp; background: #7b879448; border-radius: 14dp; padding: 0; flex-shrink: 0; }
.switch span { display: block; position: absolute; left: 3dp; top: 3dp; width: 21dp; height: 21dp; border-radius: 11dp; background: #ffffff; box-shadow: 0dp 1dp 4dp #17223030; transition: left .16s cubic-out; }
.switch.on { background-color: var(--accent); }
.switch.on span { left: 22dp; }
.switch:hover { background: #65748760; }
.switch.on:hover { background-color: var(--accent); }
.segments { display: flex; height: 38dp; padding: 3dp; gap: 3dp; background: #26221f0b; border-radius: 10dp; }
.segments button { flex: 1; height: 32dp; line-height: 32dp; border-radius: 7dp; padding: 0 6dp; color: #514b44; }
.segments button.selected { background: #ffffffbd; color: #282624; font-weight: 600; box-shadow: 0dp 2dp 5dp #263d5712; }
.hint { font-size: 12dp; line-height: 1.5; color: #514b44; margin: 11dp 0 0; }
.neural { border-top: 1dp #ffffff60; padding-top: 24dp; margin-top: 25dp; }
label { font-size: 14dp; color: #403b35; }
.field-heading { margin-bottom: 10dp; }
.field-heading span { font-size: 13dp; color: #565049; }
.slider-field { margin-top: 23dp; }
input.range { display: block; width: 100%; height: 22dp; }
input.range slidertrack { height: 3dp; margin-top: 9dp; background: #5d595535; border-radius: 2dp; }
input.range sliderprogress { height: 3dp; background-color: var(--accent); border-radius: 2dp; }
input.range sliderbar { width: 16dp; height: 16dp; margin-top: 3dp; background: #ffffff; border: 1dp #ffffff80; border-radius: 8dp; box-shadow: 0dp 1dp 5dp #1b2e5048; }
input.range sliderbar:hover { background: var(--accent-soft); }
input.range sliderarrowdec, input.range sliderarrowinc { display: none; }
.model-row { display: flex; gap: 18dp; margin-top: 18dp; }
.model-single { margin-top: 20dp; }
.model-field { flex: 1; }
.model-field label { display: block; margin-bottom: 10dp; }
.model-field select { display: block; width: 100%; }
.count-stepper { display: flex; align-items: center; justify-content: space-between; gap: 8dp; height: 50dp; box-sizing: border-box; padding: 2dp; border-radius: 10dp; background: #ffffff18; }
.count-stepper button { flex-shrink: 0; width: 42dp; height: 42dp; line-height: 42dp; padding: 0; font-size: 24dp; background: #ffffff14; }
.count-stepper span { flex: 1; text-align: center; font-size: 18dp; white-space: nowrap; }
.inspector-links { display: flex; gap: 22dp; margin-top: 23dp; }
.text-link { position: relative; text-align: left; flex: 1; color: var(--accent-ink); padding: 0; }
.chevron { position: absolute; width: 6dp; height: 6dp; right: 4dp; top: 15dp; border-right: 1.5dp #6b6660; border-bottom: 1.5dp #6b6660; transform: rotate(-45deg); }
.footer { border-top: 1dp #ffffff70; margin-top: 21dp; padding-top: 15dp; }
.history-actions { display: flex; gap: 10dp; }
.preview-note { color: #514b44; font-size: 11dp; margin: 12dp 0 0; text-align: center; }
.ratios { display: none; gap: 7dp; margin-top: 14dp; }
.ratios button { flex: 1; background: #ffffff38; }
.ratios button.selected { color: var(--accent-ink); background: #ffffffa0; font-weight: 600; }
.inspector { position: relative; width: 370dp; padding: 25dp 26dp 19dp; margin-top: 167dp; }
.inspector-heading { margin-bottom: 22dp; }
.inherit-row { margin-top: 23dp; margin-bottom: 22dp; }
.pass-tabs { margin-bottom: 8dp; }
.inspector-footer { margin-top: 20dp; border-top: 1dp #ffffff60; padding-top: 12dp; }
.inspector-footer button { padding: 0 18dp; }
#look-inspector { display: none; }
.dark { color: #f3f2f0; }
.glass.dark { background: transparent; --surface-tone: .07; --surface-grounding: .55; }
.dark h1, .dark h2, .dark button { color: #f3f2f0; }
.dark label, .dark .field-heading span, .dark .brand { color: #d4d1cd; }
.dark .hint, .dark .preview-note, .dark .quiet, .dark .compare span { color: #d6d3cf; }
.dark .segments { background: #16161630; }
.dark .segments button.selected { background: #ffffff21; color: #ffffff; }
.dark select { background: #ffffff12; border-color: #ffffff16; color: #f3f2f0; }
.dark .save { background: #ffffff22; color: var(--accent-ink); }
.dark .close .stroke { background: #d4d1cd; }
.dark .text-link { color: var(--accent-ink); }
.dark .neural, .dark .footer, .dark .inspector-footer { border-color: #ffffff20; }
.dark select selectbox { background: #2c2b2a; }
.dark select selectarrow { border-right-color: #eee9e1; border-bottom-color: #eee9e1; }
.dark .menu { background: #292827f5; }
.feature-status { display: flex; align-items: center; gap: 14dp; margin: -9dp 0 22dp; }
.status-chip { display: flex; align-items: center; gap: 7dp; height: 26dp; line-height: 26dp; padding: 0 2dp; font-size: 11dp; font-weight: 600; color: #49443e; }
.led { display: block; width: 5dp; height: 5dp; border-radius: 3dp; background: #6d7b8b; }
.status-chip.installed .led { background: #278ace; box-shadow: 0dp 0dp 7dp #2c9ae0a0; }
.status-chip.active .led { background: #1eaa7a; box-shadow: 0dp 0dp 8dp #20c497b0; animation: 2.8s cubic-in-out infinite alternate status-breathe; }
.status-chip.waiting .led { background: #c78d31; box-shadow: 0dp 0dp 6dp #d9a74b70; }
.status-chip.unavailable .led { background: #697787; opacity: .5; }
.status-note { color: #5c554c; font-size: 10dp; margin-left: auto; }
.dark .status-chip, .dark .status-note { color: #d6d3cf; }
.inspector.opening { animation: .18s cubic-out inspector-in; }
@keyframes status-breathe { from { opacity: .65; } to { opacity: 1; } }
@keyframes inspector-in { from { opacity: .5; } to { opacity: 1; } }
.reduce-motion * { animation: none; transition: none; }
scrollbarvertical { width: 6dp; margin: 12dp 3dp; background: transparent; }
scrollbarvertical slidertrack { width: 6dp; }
scrollbarvertical sliderbar { width: 5dp; min-height: 28dp; border-radius: 3dp; background: #56504955; }
scrollbarvertical sliderbar:hover { background: #56504988; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc { display: none; }
.dark scrollbarvertical sliderbar { background: #e6e2dc66; }
.main-panel > scrollbarvertical, .inspector > scrollbarvertical, .type-panel > scrollbarvertical { margin: 24dp 18dp 24dp 0; scrollbar-margin: 48dp; }
#tooltip { display: none; position: absolute; padding: 7dp 10dp; border-radius: 7dp; background: #24211ef5; color: #ffffff; font-size: 12dp; pointer-events: none; }
@media (max-width: 1050dp) {
    .workspace { left: 24dp; top: 24dp; gap: 18dp; }
    .main-panel { width: 440dp; padding: 24dp; }
    .inspector { width: 340dp; margin-top: 167dp; padding: 24dp; }
}
@media (max-height: 820dp) {
    .workspace { top: 24dp; }
    .main-panel { padding-top: 20dp; padding-bottom: 16dp; }
    h1 { margin-top: 14dp; margin-bottom: 20dp; }
    section { margin-top: 23dp; }
    .neural { margin-top: 20dp; padding-top: 20dp; }
    .inspector { margin-top: 100dp; max-height: 78vh; overflow-y: auto; }
}
.welcome { position: absolute; right: 32dp; top: 32dp; width: 500dp; height: 92dp; padding: 18dp 22dp; display: flex; align-items: center; gap: 14dp; }
.welcome .brand-logo { width: 42dp; height: 42dp; }
.welcome-copy h2 { font-size: 22dp; }
.welcome-copy p { margin: 2dp 0 0; font-size: 14dp; }
.welcome-hint { margin-left: auto; width: 130dp; font-size: 12dp; line-height: 1.4; }
.welcome .close { flex-shrink: 0; }/* Shared type and control rhythm. */
body { font-size: 20dp; color: #292624; }
button, select { font-size: 18dp; font-weight: 500; }
button { height: 44dp; line-height: 44dp; padding: 0 18dp; }
label { font-size: 18dp; }
h1 { font-size: 34dp; letter-spacing: -.4dp; }
h2 { font-size: 24dp; line-height: 1.2; }
.brand { font-size: 18dp; }
.hint { font-size: 15dp; }
.field-heading span { font-size: 16dp; }
.preview-note { font-size: 13dp; line-height: 1.4; }
.font-roboto, .font-roboto button, .font-roboto select { font-family: "Roboto"; }
.font-inter, .font-inter button, .font-inter select { font-family: "Inter Variable"; }
.workspace { left: 0; top: 0; width: 100vw; height: 100vh; display: block; }
.main-panel { position: absolute; left: 36dp; top: 76dp; width: 620dp; padding: 28dp 32dp 24dp; max-height: 88vh; }
.inspector { position: absolute; left: 680dp; top: 190dp; width: 460dp; margin: 0; padding: 28dp; max-height: 76vh; overflow-y: auto; }
.feature-status { padding: 10dp 16dp; border-radius: 14dp; background: #ffffff28; gap: 16dp; margin-top: -6dp; }
.status-chip { font-size: 15dp; height: 30dp; line-height: 30dp; padding: 0 4dp; }
.status-note { font-size: 12dp; }
.led { width: 6dp; height: 6dp; }
.dark .feature-status { background: #ffffff0d; }
section { padding: 20dp; background: #ffffff1d; border-radius: 16dp; margin-top: 20dp; }
.neural { border-top: 0; padding-top: 20dp; margin-top: 16dp; }
.dark section { background: #ffffff09; }
.section-heading { margin-bottom: 18dp; }
select, .save { height: 46dp; }
select { padding: 10dp 16dp; }
.segments { height: 46dp; padding: 3dp; }
.segments button { height: 40dp; line-height: 40dp; padding: 0 12dp; }
.inspector-links { gap: 14dp; }
.text-link { height: 48dp; line-height: 48dp; padding: 0 34dp 0 16dp; background: #ffffff32; border-radius: 11dp; }
.dark .text-link { background: #ffffff12; }
.chevron { right: 16dp; top: 20dp; }
.glyph { width: 20dp; height: 20dp; vertical-align: middle; margin-right: 9dp; }
.dark .glyph { image-color: #ece8e2; }
.text-link .glyph { width: 19dp; height: 19dp; margin-right: 8dp; }
.history-actions { margin-left: 0; gap: 10dp; }
.history-actions button { padding: 0 12dp; }
.switch { width: 48dp; height: 28dp; padding: 0; }
.switch span { width: 22dp; height: 22dp; }
.switch.on span { left: 23dp; }
.menu { width: 184dp; }
.menu button { padding: 0 16dp; }
.dark .menu { background: #292723f5; }
#tooltip { background: #24211ef5; font-size: 15dp; }
.prototype-toolbar { position: absolute; left: 50%; top: 14dp; transform: translateX(-50%); display: flex; align-items: center; gap: 16dp; padding: 5dp 10dp; border-radius: 14dp; background: #f0ece6ec; z-index: 100; color: #302c27; }
.prototype-toolbar button { font-size: 16dp; height: 36dp; line-height: 36dp; padding: 0 14dp; }
.prototype-toolbar button.selected { background: #c7685024; color: #813e2b; }
#layout-switch { display: flex; }
.prototype-toolbar select { width: 116dp; height: 36dp; font-size: 16dp; padding: 5dp 10dp; }
.sidebar { display: none; }
.welcome { z-index: 3; }
.layout-centered .main-panel { left: 50vw; top: 50vh; margin-left: -470dp; margin-top: -390dp; width: 940dp; height: 780dp; max-height: 88vh; overflow-y: hidden; }
.layout-centered .sidebar { display: block; position: absolute; left: 28dp; top: 160dp; width: 190dp; }
.layout-centered .sidebar button { display: block; width: 100%; text-align: left; margin-bottom: 10dp; font-size: 18dp; padding: 0 16dp; }
.layout-centered .overview { position: absolute; left: 242dp; top: 150dp; width: 660dp; height: 590dp; overflow-y: auto; padding-right: 12dp; }
.layout-centered .inspector { left: 50vw; top: 50vh; margin-left: -228dp; margin-top: -240dp; width: 660dp; height: 580dp; max-height: 70vh; }
.layout-centered .inspector-links { display: none; }
.layout-centered .main-panel h1 { margin-bottom: 0; }
.layout-bar .main-panel { left: 24dp; top: 100vh; margin-top: -390dp; width: 96vw; height: 360dp; max-height: 90vh; padding: 22dp 28dp; }
.layout-bar .main-panel h1, .layout-bar .overview .preset-row, .layout-bar .overview .slider-field, .layout-bar .overview .model-row, .layout-bar .overview .field-heading { display: none; }
.layout-bar .feature-status { position: absolute; left: 260dp; top: 28dp; width: 360dp; margin: 0; padding: 0 12dp; background: transparent; }
.layout-bar .tuning-sections { display: flex; gap: 22dp; margin-top: 18dp; }
.layout-bar section { flex: 1; margin: 0; padding: 14dp 18dp; }
.layout-bar h2 { font-size: 22dp; }
.layout-bar .neural { padding-top: 14dp; }
.layout-bar .inspector-links { margin-top: 12dp; }
.layout-bar .text-link { font-size: 16dp; }
.layout-bar .inspector { left: 55vw; top: 80dp; width: 460dp; max-height: 52vh; }
.layout-bar .footer { margin-top: 12dp; padding-top: 8dp; }
.layout-bar .preview-note { display: none; }
@media (max-width: 1300dp) {
 .main-panel { width: 570dp; left: 24dp; padding: 24dp; }
 .inspector { width: 420dp; left: 620dp; padding: 24dp; }
 .welcome { width: 400dp; }
 .welcome-hint { display: none; }
}

body { width: 100vw; height: 100vh; }
.prototype-toolbar { left: 50vw; }
.glyph { image-color: #514b44; }
.dark .glyph { image-color: #ece8e2; }
body { --copy-font: Roboto; --copy-size: 20dp; --copy-weight: 500; --heading-font: Bakbak One; --heading-size: 34dp; --heading-weight: 400; font-family: var(--copy-font); font-size: var(--copy-size); font-weight: var(--copy-weight); }
button, select { font-family: var(--copy-font); font-size: var(--copy-size); font-weight: var(--copy-weight); }
label { font-size: var(--copy-size); }
h1, h2 { font-family: var(--heading-font); font-weight: var(--heading-weight); }
h1 { font-size: var(--heading-size); }
h2 { font-size: var(--section-size); }
.brand, .welcome-copy h2 { font-family: "Bakbak One"; font-weight: 400; font-size: 23dp; }
.hint { font-size: var(--hint-size); }
.field-heading span { font-size: var(--value-size); }
.type-panel { position: absolute; right: 24dp; top: 140dp; width: 380dp; padding: 24dp; max-height: 76vh; overflow-y: auto; z-index: 20; }
.type-panel label, .type-panel button, .type-panel select { font-size: 17dp; }
.type-panel .field-heading span { font-size: 15dp; }
.type-panel select { display: block; width: 100%; margin-top: 10dp; }
.type-panel .slider-field { margin-top: 20dp; }
.type-label { display: block; margin-top: 22dp; }
.type-panel .text-link { width: 100%; margin-top: 22dp; }
.type-panel h2 { font-size: 24dp; }
.type-panel input:disabled { opacity: .35; }

body { --section-size: 24dp; --hint-size: 16dp; --value-size: 17dp; }

paint-root { display: block; }
.welcome { --shadow-radius: 16; --shadow-offset: 6; --shadow-opacity: .12; }

.main-panel { padding: 36dp 40dp 30dp; }
.inspector { padding: 34dp; }
.type-panel { width: 420dp; padding: 32dp; }
button { height: 48dp; line-height: 48dp; padding: 0 22dp; }
select, .save { height: 50dp; }
select { padding: 12dp 20dp; }
.segments { height: 52dp; padding: 4dp; gap: 4dp; }
.segments button { height: 44dp; line-height: 44dp; padding: 0 16dp; }
section { padding: 26dp; }
.text-link { height: 54dp; line-height: 54dp; padding: 0 36dp 0 20dp; }
.text-link .chevron { top: 24dp; right: 18dp; }
.glyph { width: 22dp; height: 22dp; margin-right: 10dp; }
h2 .glyph { width: 24dp; height: 24dp; }
.close { height: 32dp; width: 32dp; line-height: 32dp; padding: 0; }
.switch { height: 28dp; width: 48dp; padding: 0; }
h1, h2, .dark h1, .dark h2 { color: var(--accent-ink); }
.brand, .welcome-wordmark { font-family: "Bakbak One"; font-size: 27dp; font-weight: 400; color: #514b44; }
.brand-lockup .brand-logo { width: 36dp; height: 36dp; }
.dark .brand, .dark .welcome-wordmark { color: #e6e2dc; }
.welcome { height: 54dp; width: 420dp; padding: 10dp 16dp; gap: 10dp; --shadow-radius: 12; --shadow-offset: 4; }
.welcome .brand-logo { height: 30dp; width: 30dp; }
.welcome-copy { display: flex; align-items: center; gap: 16dp; }
.welcome-wordmark { font-size: 22dp; }
.welcome-message { font-size: 16dp; }
.welcome .close { margin-left: auto; }
.layout-centered .main-panel { width: 1040dp; height: 900dp; margin-left: -520dp; margin-top: -450dp; }
.layout-centered .sidebar { left: 28dp; top: 160dp; width: 226dp; }
.layout-centered .sidebar button { height: 52dp; line-height: 52dp; font-size: 18dp; padding: 0 14dp; }
.layout-centered .overview { left: 280dp; width: 720dp; height: 700dp; }
.layout-centered .inspector { margin-left: -240dp; margin-top: -300dp; width: 720dp; height: 700dp; }
.layout-centered.frame-page #neural-section { display: none; }
.layout-centered.neural-page #frame-section { display: none; }
.inspector.opening { animation: none; }
button { transition: background-color .14s cubic-out, transform .10s cubic-out; }
button:active { transform: scale(.98); }
.switch:active, .close:active { transform: none; }
.reduce-motion button { transition: none; }
.glass { --material-blend-opacity: .65; --material-blur: 32; }
.clear { transition: color .18s cubic-out; }
.layout-bar .footer { padding-right: 440dp; justify-content: flex-start; gap: 30dp; }
.layout-bar #defaults { margin-left: 20dp; }
.reduce-motion .clear { transition: none; }
.advanced-section { display: none; margin-top: 28dp; border-top: 1dp #ffffff24; padding-top: 8dp; }
.layout-centered.neural-page #extra-neural, .layout-centered.frame-page #extra-frame { display: block; }
#extra-processing select, #extra-frame-popup select, .advanced-section select, #extra-look select { width: 100%; margin-top: 10dp; }
.icon-button { margin-left: auto; margin-right: 12dp; width: 36dp; height: 36dp; padding: 0; line-height: 36dp; }
.icon-button .glyph { margin: 0; width: 22dp; height: 22dp; }
.clear.dark label, .clear.dark .hint, .clear.dark .field-heading span { color: #f5f1eb; }
/* Appearance and section editors share one spacious control system. */
.main-panel { width: 660dp; max-height: 92vh; }
.inspector { width: 520dp; left: 720dp; padding: 32dp; max-height: 80vh; }
.model-row { gap: 20dp; align-items: flex-end; }
.model-field { min-width: 0; }
.model-field label { white-space: nowrap; }
.ratios button { padding: 0 8dp; font-size: 18dp; }
.preview-label { font-size: 15dp; color: #514b44; margin: 0 8dp; }
.prototype-toolbar { left: 50vw; padding: 7dp 12dp; }
#scene-select { width: 230dp; height: 38dp; font-size: 17dp; margin: 0; }
.settings-menu { width: 280dp; right: 0; top: 46dp; padding: 12dp; }
.settings-menu button { height: 48dp; line-height: 48dp; font-size: 19dp; padding: 0 14dp; }
.settings-menu #layout-switch { display: flex; }
.settings-menu #layout-switch button { display: block; text-align: center; }
.settings-menu button.selected { background-color: var(--accent-soft); }
.menu-label { font-size: 13dp; color: #776e62; margin: 18dp 14dp 8dp; }
.dark .menu-label { color: #bfb5a8; }
.appearance-panel { width: 480dp; padding: 30dp 32dp; overflow-y: hidden; max-height: 84vh; }
.settings-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 26dp; gap: 16dp; }
.settings-heading h2 { font-size: 26dp; white-space: nowrap; }
.appearance-body { max-height: 70vh; overflow-y: auto; padding-right: 8dp; }
.appearance-block { margin-bottom: 26dp; }
.appearance-block > label { display: block; margin-bottom: 12dp; }
.appearance-panel label, .appearance-panel select, .appearance-panel button { font-size: 19dp; }
.appearance-panel select { height: 48dp; width: 100%; margin: 0; }
.appearance-panel .field-heading span { font-size: 17dp; }
.appearance-panel .hint { font-size: 15dp; line-height: 1.5; }
.text-presets { display: flex; gap: 10dp; }
.text-presets button { display: flex; flex-direction: column; align-items: center; justify-content: center; flex: 1; height: 86dp; line-height: 1.2; padding: 12dp; background: #ffffff20; border-radius: 12dp; }
.type-sample { display: block; font-size: 26dp; margin-bottom: 7dp; }
.sample-small { font-size: 23dp; }
.sample-large { font-size: 29dp; }
.type-caption { display: block; font-size: 14dp; }
.text-presets button.selected, .theme-swatches button.selected { background-color: var(--accent-soft); box-shadow: 0dp 0dp 0dp 1dp var(--accent); }
.scale-row, .scale-stepper { display: flex; align-items: center; justify-content: space-between; }
.scale-row > label { margin: 0; }
.scale-stepper { gap: 8dp; background: #ffffff18; border-radius: 12dp; padding: 2dp; }
.scale-stepper button { width: 44dp; height: 42dp; line-height: 42dp; padding: 0; font-size: 24dp; }
#scale-value { min-width: 68dp; text-align: center; font-size: 19dp; }
.theme-swatches { display: flex; gap: 10dp; }
.theme-swatches button { display: flex; flex-direction: column; align-items: center; justify-content: center; flex: 1; height: 100dp; line-height: 1.2; padding: 12dp; border-radius: 12dp; background: #ffffff10; font-size: 16dp; }
.theme-sample { display: block; width: 58dp; height: 34dp; border-radius: 9dp; margin-bottom: 12dp; border: 1dp #ffffff50; }
.light-sample { background: #f6f1e9; }
.dark-sample { background: #24211e; }
.clear-sample { background: #ffffff18; border-color: #ffffff80; }
.more-trigger { display: flex; align-items: center; position: relative; width: 100%; height: 58dp; line-height: 58dp; padding: 0 18dp; background: #ffffff18; text-align: left; }
.more-trigger .chevron { top: 24dp; right: 20dp; }
.more-trigger.expanded .chevron { transform: rotate(45deg); }
.appearance-details { padding: 4dp 4dp 12dp; }
.appearance-details .slider-field { margin-top: 26dp; }
.appearance-details .inherit-row { margin-top: 26dp; margin-bottom: 0; gap: 20dp; }
.appearance-details .inherit-row label { flex: 1; line-height: 1.4; }
.appearance-details .text-link { margin-top: 28dp; }
.appearance-details .switch { width: 48dp; height: 28dp; padding: 0; }
.toast-shapes { margin-top: 12dp; }
.welcome { height: 56dp; width: 620dp; gap: 12dp; --corner-radius: 14; border-radius: 14dp; }
.welcome-wordmark { flex-shrink: 0; }
.welcome-message { display: inline; white-space: nowrap; line-height: 30dp; }
.keycap { display: inline-block; min-width: 32dp; height: 26dp; line-height: 25dp; padding: 0 7dp; margin: 0 4dp; border-radius: 6dp; background: #ffffff20; border: 1dp #ffffff50; font-size: 14dp; font-weight: 600; text-align: center; }
.option-group { display: block; padding: 22dp; background: #ffffff14; border-radius: 15dp; margin: 20dp 0; }
.option-group h3, .history-heading h3 { font-family: var(--copy-font); font-size: 17dp; font-weight: 600; color: var(--accent-ink); margin: 0 0 18dp; }
.option-group .slider-field:first-child { margin-top: 0; }
.group-heading { display: block; position: relative; width: 100%; height: 42dp; line-height: 42dp; padding: 0 24dp 0 0; font-size: 18dp; text-align: left; color: var(--accent-ink); }
.group-heading .chevron { right: 6dp; top: 16dp; }
.group-heading.expanded .chevron { transform: rotate(45deg); }
.sidebar button.selected { background: var(--accent-soft); color: var(--accent-ink); }
.group-availability { margin: 0 0 14dp; font-size: 15dp; line-height: 1.4; }
.group-body { padding-top: 20dp; }
.option-group .inherit-row { gap: 14dp; margin: 20dp 0; }
.option-group .inherit-row label { flex: 1; line-height: 1.4; }
.option-group .field-heading label { flex: 1; min-width: 0; line-height: 1.35; }
.option-group .field-heading span { margin-left: 12dp; white-space: nowrap; }
.reset-value { flex-shrink: 0; width: 28dp; height: 28dp; line-height: 28dp; padding: 0; margin-left: 8dp; opacity: .6; }
.reset-value .glyph { width: 16dp; height: 16dp; margin: 0; }
.reset-value:hover { opacity: 1; }
.dark .option-group { background: #ffffff0b; }
.dark-inverted .dark section, .dark-inverted .dark .option-group { background: #02020255; }
.inspector-footer { margin-top: 26dp; padding-top: 18dp; }
.inspector-footer button { font-size: 17dp; }
.metadata-compact { position: relative; display: block; width: 100%; height: auto; padding: 16dp 20dp; line-height: 1.3; margin: 0 0 24dp; background: #ffffff18; border-radius: 15dp; text-align: left; }
.metadata-top, .metadata-line { display: flex; align-items: center; gap: 18dp; }
.metadata-top { font-size: 19dp; margin-bottom: 8dp; }
.metadata-top .chevron { top: 22dp; right: 20dp; }
.metadata-line { font-size: 14dp; }
.metadata-compact .feature-status { margin: 12dp 0 0; padding: 0; background: transparent; gap: 18dp; }
.metadata-compact .status-chip { height: 24dp; line-height: 24dp; font-size: 13dp; }
.metadata-expanded { display: none; }
.session-heading { display: flex; align-items: center; gap: 12dp; font-size: 19dp; margin-bottom: 28dp; }
.session-dot { width: 7dp; height: 7dp; border-radius: 4dp; background: var(--accent); }
.preview-badge { margin-left: auto; font-size: 13dp; opacity: .7; }
.session-facts { display: flex; flex-wrap: wrap; gap: 20dp 28dp; padding-bottom: 28dp; border-bottom: 1dp #ffffff22; }
.session-facts div { flex: 1 1 130dp; min-width: 0; }
.session-facts div:last-child { flex-basis: 100%; }
.session-facts label { display: block; font-size: 14dp; margin-bottom: 8dp; }
.session-facts span { display: block; font-size: 18dp; white-space: normal; word-break: break-word; }
.runtime-metrics { display: flex; flex-wrap: wrap; gap: 16dp; margin: 26dp 0 32dp; }
.runtime-metric { width: 46%; padding: 18dp 20dp; background: #ffffff12; border-radius: 12dp; }
.runtime-metric label { display: block; font-size: 15dp; }
.runtime-metric strong { display: block; font-size: 36dp; font-weight: 500; margin-top: 10dp; }
.history-heading { display: flex; justify-content: space-between; align-items: center; }
.history-heading h3 { margin: 0; }
.history-heading span { font-size: 13dp; }
.history-empty { position: relative; height: 160dp; margin-top: 18dp; }
.history-empty p { position: absolute; top: 64dp; left: 10dp; right: 10dp; font-size: 16dp; text-align: center; }
.history-rule { position: absolute; height: 1dp; width: 100%; background: #ffffff15; }
.rule-one { top: 20dp; }.rule-two { top: 80dp; }.rule-three { top: 140dp; }
.history-axis { display: flex; justify-content: space-between; font-size: 13dp; opacity: .7; }
.sample-history { position: absolute; left: 0; right: 0; top: 12dp; bottom: 14dp; }
.sample-history-bar { position: absolute; bottom: 0; width: 1%; border-radius: 2dp; background: var(--accent); opacity: .7; }
.glass .sample-flow.glyph { width: 16dp; height: 16dp; margin: 0 4dp; vertical-align: middle; transform: rotate(180deg); }
.layout-centered.overview-page .metadata-compact, .layout-centered.overview-page #tuning-content { display: none; }
.layout-centered.overview-page #overview-metadata { display: block; }
.layout-centered.frame-page .metadata-compact, .layout-centered.neural-page .metadata-compact { display: none; }
.session-inspector #popup-metadata { display: block; }
.session-inspector .inspector-footer { display: none; }
.layout-bar .metadata-compact { position: absolute; left: 230dp; top: 16dp; width: 380dp; height: 54dp; padding: 6dp 14dp; margin: 0; background: transparent; }
.layout-bar .metadata-compact .metadata-top { margin-bottom: 3dp; font-size: 16dp; }
.layout-bar .metadata-compact .metadata-line { font-size: 12dp; gap: 12dp; }
.layout-bar .metadata-compact .feature-status { display: none; }
.layout-bar .tuning-sections { margin-top: 24dp; }
@media (max-width: 1400dp) {
 .main-panel { width: 580dp; }
 .inspector { width: 470dp; left: 50vw; }
 .appearance-panel { width: 440dp; }
 .layout-centered .main-panel { width: 940dp; margin-left: -470dp; }
 .layout-centered .overview { width: 620dp; }
 .layout-centered .inspector { width: 620dp; }
}
.welcome { height: 42dp; width: 500dp; padding: 6dp 14dp; border-radius: 12dp; --corner-radius: 12; }
.welcome-wordmark { font-size: 18dp; }
.welcome-message { font-size: 14dp; line-height: 25dp; }
.welcome .brand-logo { width: 27dp; height: 27dp; }
.welcome .close { width: 28dp; height: 28dp; }
.keycap { height: 22dp; line-height: 21dp; font-size: 13dp; }
.settings-screen { padding: 0 0 18dp; }
.settings-title { display: flex; align-items: center; justify-content: space-between; margin: 8dp 0 28dp; }
.settings-title h2 { font-size: 30dp; }
.settings-title button { padding: 0 16dp; height: 44dp; }
.settings-appearance { position: relative; display: flex; align-items: center; width: 100%; padding: 20dp 24dp; background: #ffffff18; text-align: left; height: auto; line-height: 1.4; }
.settings-appearance .glyph { width: 26dp; height: 26dp; margin-right: 18dp; }
.settings-appearance .chevron { right: 24dp; top: 30dp; }
.setting-description { display: block; font-size: 16dp; margin-top: 4dp; opacity: .75; }
.settings-group { margin-top: 34dp; }
.settings-group h3 { display: block; font-family: var(--heading-font); color: var(--accent-ink); font-size: 22dp; line-height: 1.25; margin: 0; padding-bottom: 18dp; }
.settings-layouts { display: flex; gap: 10dp; }
.settings-layouts button { display: flex; flex-direction: column; align-items: center; justify-content: center; flex: 1; min-width: 0; height: 136dp; box-sizing: border-box; line-height: 1.25; padding: 14dp 10dp; font-size: 16dp; white-space: normal; background: #ffffff12; }
.settings-layouts button.selected { background: var(--accent-soft); }
.settings-group .inherit-row { display: flex; align-items: center; justify-content: space-between; gap: 24dp; margin: 22dp 0; }
.settings-group .inherit-row label { flex: 1; }
.settings-group select { width: 100%; margin-top: 12dp; margin-bottom: 18dp; }
.settings-group .hint { font-size: 16dp; line-height: 1.5; }
.shortcut-bind { display: flex; align-items: center; justify-content: space-between; width: 100%; padding: 14dp 20dp; height: auto; line-height: 32dp; background: #ffffff12; }
.shortcut-bind .keycap { min-width: 54dp; height: 30dp; line-height: 29dp; }
.settings-page .main-panel > h1 { display: none; }
.layout-centered .settings-screen { position: absolute; left: 280dp; top: 154dp; width: 720dp; height: 700dp; overflow-y: auto; padding-right: 24dp; }
.layout-bar.settings-page .main-panel { width: 660dp; height: auto; max-height: 88vh; left: 32dp; top: 32dp; bottom: auto; margin-left: 0; margin-top: 0; padding: 30dp 38dp; }
.layout-bar.settings-page .brand-row { position: relative; left: auto; top: auto; width: auto; }
.layout-bar.settings-page .window-actions { display: flex; }
.layout-bar.settings-page .settings-screen { display: block; }
.compact-live { display: flex; gap: 14dp; margin-top: 14dp; }
.mini-stat { flex: 1; min-width: 0; height: 68dp; padding: 10dp 14dp; border-radius: 10dp; background: #ffffff0b; }
.mini-stat-label { display: flex; align-items: center; font-size: 12dp; white-space: nowrap; }
.mini-stat-label .glyph { width: 14dp; height: 14dp; margin-right: 7dp; }
.mini-stat-value { display: block; margin-top: 8dp; font-size: 20dp; line-height: 1.3; }
.mini-stat-reading { display: flex; align-items: baseline; justify-content: space-between; gap: 8dp; }
.mini-stat-detail { font-size: 11dp; line-height: 1.25; text-align: right; }
.metric-badge { margin-left: auto; font-size: 12dp; color: var(--accent-ink); }
.layout-bar .compact-live { display: none; }
.layout-centered .sidebar #nav-settings { margin-top: 20dp; }
@media (max-width: 1400dp) { .layout-centered .settings-screen { width: 620dp; } }

.save-sheet { padding: 20dp; background: #ffffff18; border-radius: 14dp; margin-bottom: 24dp; }
.save-sheet input { display: block; width: 100%; height: 48dp; margin-top: 12dp; padding: 0 14dp; border-radius: 10dp; background: #ffffff18; }
.save-actions { display: flex; justify-content: flex-end; gap: 12dp; margin-top: 16dp; }
.save-actions button { height: 44dp; padding: 0 16dp; font-size: 17dp; }
.quiet, .save, .segments button, .count-stepper button { display: flex; align-items: center; justify-content: center; line-height: 1.25; }
.quiet .glyph, .save .glyph { margin-right: 9dp; }
.text-link, .group-heading, .layout-centered .sidebar button { display: flex; align-items: center; justify-content: flex-start; line-height: 1.25; }
.reset-value { display: flex; align-items: center; justify-content: center; }

/* Layout diagrams share the real three window arrangements. */
.layout-screen { display: block; flex-shrink: 0; position: relative; width: 100%; height: 72dp; margin-bottom: 12dp; border-radius: 6dp; background: #3e3b370b; }
.layout-caption { display: block; height: auto; line-height: 1.25; text-align: center; }
.mini-panel, .mini-popover { position: absolute; display: block; border-radius: 4dp; background: #3e3b372e; border: 1dp #3e3b3755; padding: 6dp; box-sizing: border-box; }
.mini-heading { display: block; width: 58%; height: 3dp; margin-bottom: 6dp; border-radius: 2dp; background: var(--accent); }
.mini-card { display: block; height: 11dp; margin-bottom: 5dp; border-radius: 2dp; background: #3e3b373b; }
.mini-line { display: block; height: 3dp; margin-bottom: 6dp; background: #3e3b3780; border-radius: 2dp; }
.dark .layout-screen, .clear .layout-screen { background: #ffffff0c; }
.dark .mini-panel, .dark .mini-popover, .clear .mini-panel, .clear .mini-popover { background: #ffffff28; border-color: #ffffff50; }
.dark .mini-card, .clear .mini-card { background: #ffffff30; }
.dark .mini-line, .clear .mini-line { background: #ffffff70; }
.layout-sidebar .mini-panel { left: 8%; top: 10%; width: 38%; height: 80%; }
.layout-sidebar .mini-popover { left: 52%; top: 36%; width: 26%; height: 43%; }
.layout-advanced .mini-panel { left: 12%; top: 14%; width: 76%; height: 72%; display: flex; gap: 7dp; }
.mini-nav { display: block; width: 28%; }
.mini-content { display: block; flex: 1; }
.mini-content .mini-card { height: 18dp; }
.layout-bottom .mini-panel { left: 8%; top: 72%; width: 84%; height: 19%; padding: 3dp; display: flex; gap: 5dp; }
.layout-bottom .mini-panel .mini-heading { width: 25%; }
.layout-bottom .mini-panel .mini-line { width: 22%; }
.layout-bottom .mini-popover { left: 52%; top: 20%; width: 35%; height: 44%; }

/* HDR shares the same card rhythm and fields as neural rendering. */
#hdr-page { display: none; }
.layout-centered.hdr-page #hdr-page { display: block; }
.layout-centered.hdr-page .metadata-compact, .layout-centered.hdr-page #overview-metadata, .layout-centered.hdr-page #tuning-content { display: none; }
.hdr-entry { display: flex; align-items: center; justify-content: center; gap: 12dp; width: 100%; margin-top: 22dp; padding: 14dp 20dp; background: #ffffff16; border-radius: 12dp; }
.layout-centered .hdr-entry { display: none; }
.hdr-field { margin-bottom: 24dp; }
#hdr-main-note, #hdr-popup-note { margin: 10dp 0 26dp; line-height: 1.5; }
#hdr-main-fields .option-group h3 { padding-bottom: 18dp; }

.button-label { display: block; flex-shrink: 0; }
.count-stepper button .button-label { font-size: 24dp; }
.layout-bar .model-single { display: none; }
.layout-bar .hdr-entry { position: absolute; top: 14dp; right: 160dp; width: 110dp; height: 44dp; margin: 0; padding: 8dp 14dp; }
#hdr-main-fields select, #hdr-popup-fields select { display: block; width: 100%; }
#hdr-main-fields h3 { text-transform: uppercase; }

/* Clear never inverts individual text or glyphs. Depth belongs to whole rows. */
.clear .close .stroke { background: #f5f1ea; }
.clear .chevron { border-right-color: #f5f1ea; border-bottom-color: #f5f1ea; }
.clear select selectarrow { border-right-color: #f5f1ea; border-bottom-color: #f5f1ea; }
.clear select selectbox, .clear .menu { background: #27231ff5; color: #f5f1ea; }
.clear select option, .clear .menu button { color: #f5f1ea; }

.clear-foreground .prototype-toolbar { background: #27231fe8; color: #f5f1ea; }
.clear-foreground .prototype-toolbar .preview-label, .clear-foreground .prototype-toolbar select { color: #f5f1ea; }
.clear-foreground .prototype-toolbar select { background: #ffffff18; }
.clear-foreground .prototype-toolbar select selectarrow { border-right-color: #f5f1ea; border-bottom-color: #f5f1ea; }
.clear-foreground .prototype-toolbar select selectbox { background: #27231ff5; color: #f5f1ea; }
.clear-foreground .prototype-toolbar select option { color: #f5f1ea; }

.clear, .clear * { color: #f5f1ea; }
.clear .glyph { image-color: #f5f1ea; }

/* Window bounds come from the shared controller, in the current viewport's
   pixels. Content regions use those same bounds at every text/overlay scale. */
.layout-centered .main-panel { margin: 0; }
.layout-centered .sidebar { overflow-y: auto; padding-right: 8dp; }
.layout-centered .sidebar button { min-height: 52dp; height: auto; padding: 14dp; }
.layout-centered .sidebar .button-label { min-width: 0; flex-shrink: 1; white-space: normal; }
.layout-centered .overview, .layout-centered .settings-screen, .layout-centered .inspector { padding: 28dp; background: #ffffff18; border: 1dp #ffffff24; border-radius: 24dp; }
.layout-centered .inspector { margin: 0; box-shadow: none; }
.layout-centered .sidebar #nav-settings { margin-top: 24dp; }
.compact-content .model-row { flex-direction: column; align-items: stretch; }
.compact-content .model-field { flex: auto; width: 100%; }
.compact-content .inspector-links { flex-direction: column; }
.compact-content .text-link { flex: auto; width: 100%; }
.compact-content .session-facts { flex-wrap: wrap; gap: 18dp; }
.compact-content .session-facts div { min-width: 40%; }
.compact-content .runtime-metric { width: 100%; }
.layout-bar .main-panel { height: auto; margin: 0; }
.layout-bar .tuning-footer { display: flex; flex-wrap: wrap; align-items: center; gap: 18dp 28dp; margin-top: 18dp; padding-top: 16dp; border-top: 1dp #ffffff24; }
.layout-bar .footer { flex: 1; margin: 0; padding: 0; border: 0; gap: 16dp; }
.layout-bar #defaults { margin-left: 0; }
.layout-bar.compact-bar .tuning-sections { flex-direction: column; }
.layout-bar.compact-bar .tuning-sections section { flex: auto; width: 100%; }
.layout-bar.compact-bar .metadata-compact { display: none; }
.layout-bar.compact-bar .hdr-entry { right: 130dp; }
.glyph { flex-shrink: 0; }
.close, .icon-button { display: flex; align-items: center; justify-content: center; line-height: 1; flex-shrink: 0; }
.close .glyph, .icon-button .glyph, .reset-value .glyph, .hdr-entry .glyph { margin: 0; }
.close .stroke { left: 50%; top: 50%; margin-left: -7dp; margin-top: -.75dp; }
h2, .model-field label.icon-label, .field-heading label.icon-label { display: flex; align-items: center; }
h2 .glyph, .model-field label .glyph, .field-heading label .glyph { margin: 0 10dp 0 0; }
.section-heading { gap: 10dp; }
.section-heading h2 { flex: 1; min-width: 0; }
.section-heading .icon-button { margin-left: 0; margin-right: 0; }
.button-label { flex-shrink: 1; min-width: 0; }
.hdr-entry .chevron, .text-link .chevron, .group-heading .chevron, .more-trigger .chevron, .settings-appearance .chevron { top: 50%; margin-top: -3dp; }
/* RmlUi positions selectarrow in the select's content box itself. Match that
   inset rather than applying CSS absolute positioning that it overrides. */
select selectarrow { position: static; margin: 7dp 18dp 0 0; }
.appearance-panel select selectarrow { margin-top: 6dp; }
#scene-select selectarrow { margin-top: 9dp; }
select selectvalue { min-width: 0; padding-right: 28dp; }
.welcome { max-width: 96vw; }
.group-heading { height: 50dp; padding: 0 44dp 0 18dp; }
.group-heading .chevron { right: 18dp; }
.layout-centered .sidebar #nav-look, .layout-centered .sidebar #nav-passes { padding-left: 26dp; font-size: 17dp; }
.layout-centered .sidebar #nav-frame { margin-top: 18dp; }
.compact-height .settings-heading { margin-bottom: 18dp; }
.compact-height .appearance-block { margin-bottom: 18dp; }
.layout-centered.settings-page .main-panel > h1 { display: block; }
.layout-centered.settings-page.compact-height .main-panel > h1 { display: none; }

/* Main chrome stays outside the scrolling tuning region. */
/* Scroll clipping belongs to the content slot. Clipping the rounded outer
   wrapper also masks positioned header actions and the sticky footer. */
.main-panel, .layout-centered .main-panel { display: flex; flex-direction: column; overflow: visible; }
.brand-row, .main-panel > h1, .tuning-footer { flex-shrink: 0; }
.overview, .settings-screen { min-height: 0; overflow-y: auto; }
.main-panel > .overview, .main-panel > .settings-screen { flex: 1; }
.tuning-footer { margin-top: 20dp; padding-top: 16dp; border-top: 1dp #ffffff24; }
.tuning-footer .footer { margin: 0; padding: 0; border: 0; gap: 12dp; }
.preview-original { width: 100%; margin-top: 14dp; font-size: 17dp; }
.preview-original.selected { background: var(--accent-soft); }
.layout-centered .tuning-footer { margin: 0; position: absolute; left: 280dp; right: 40dp; bottom: 26dp; display: flex; align-items: center; gap: 16dp; }
.layout-centered .tuning-footer .footer { flex: 1; }
.layout-centered .preview-original { width: auto; margin: 0; padding: 0 16dp; }
.layout-bar .overview { position: relative; overflow-y: auto; }
.layout-bar .tuning-footer { display: flex; align-items: center; gap: 18dp; }
.layout-bar .preview-original { width: auto; margin: 0; padding: 0 20dp; }
.settings-page .main-panel > .tuning-footer { display: none; }
.bar-settings .main-panel > .tuning-footer { display: flex; }
.layout-bar.bar-settings .main-panel { pointer-events: none; }
.bar-settings #inspector .inspector-heading, .bar-settings #inspector .inspector-footer, .bar-settings #inspector > div { display: none; }
.bar-settings #inspector #settings-modal-host { display: block; }
.bar-settings #settings-screen { position: relative; width: 100%; height: auto; padding: 0; overflow-y: visible; }
.bar-settings #settings-screen .settings-title { margin-top: 0; }
