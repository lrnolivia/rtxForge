<!--
    rtxForge control styles. Built on Fluent resources (ThemeResource lookups
    resolve against XamlControlsResources at runtime), so corner radii, fills
    and strokes are the native Windows ones. Comments name the libadwaita /
    GTK CSS class each style stands in for.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Themes/Tokens.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ===== Text ===== -->

    <!-- .eyebrow -->
    <Style x:Key="ForgeEyebrowTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource ForgeEyebrowBrush}" />
        <Setter Property="FontSize" Value="{StaticResource ForgeEyebrowFontSize}" />
        <Setter Property="FontWeight" Value="ExtraBold" />
        <Setter Property="CharacterSpacing" Value="190" />
    </Style>

    <!-- .hero-title -->
    <Style x:Key="ForgeHeroTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource ForgeHeroFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource ForgeHeroTitleFontSize}" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- Fluent page title (TitleTextBlockStyle) -->
    <Style x:Key="ForgePageTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- .heading / Fluent BodyStrong -->
    <Style x:Key="ForgeHeadingTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- .dim-label -->
    <Style x:Key="ForgeDimTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- .card-meta / Fluent Caption -->
    <Style x:Key="ForgeCaptionDimTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- ===== Surfaces ===== -->

    <!-- .control-pod: a Fluent card -->
    <Style x:Key="ForgeControlPodStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="20,16,20,16" />
    </Style>

    <!-- Adw.ActionRow: a Fluent settings card -->
    <Style x:Key="ForgeSettingsCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="MinHeight" Value="68" />
        <Setter Property="Padding" Value="16,12,16,12" />
    </Style>

    <!-- Library card -->
    <Style x:Key="ForgeGameCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
    </Style>

    <!-- Library card as a Grid (art row + footer row); clips to its corners -->
    <Style x:Key="ForgeGameCardGridStyle" TargetType="Grid">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ForgeCardCornerRadius}" />
    </Style>

    <!-- Library selection check. Purely visual: the library page decides in
         ItemInvoked whether the press landed on it (Tag="check"), so one click
         is handled exactly once. -->
    <Style x:Key="ForgeCheckStyle" TargetType="Border">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
    </Style>

    <!-- OS mark on the card art (top left, opposite the check): translucent so the art shows through -->
    <Style x:Key="ForgePosterBadgeStyle" TargetType="Border">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background" Value="#59000000" />
        <Setter Property="BorderBrush" Value="#38FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
    </Style>

    <!-- .library-meta-pill -->
    <Style x:Key="ForgePillStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="6,2,6,2" />
    </Style>

    <!-- .mode-selector (Adw.ToggleGroup): Fluent segmented control container -->
    <Style x:Key="ForgeSegmentGroupStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ControlAltFillColorSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===== Segmented item (Adw.Toggle) ===== -->

    <Style x:Key="ForgeSegmentStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="Padding" Value="14,5,14,6" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Background="Transparent" CornerRadius="{ThemeResource ControlCornerRadius}">
                        <Border x:Name="CheckedLayer" Background="{ThemeResource ControlFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource ControlElevationBorderBrush}" BorderThickness="1"
                                CornerRadius="{ThemeResource ControlCornerRadius}" Opacity="0" />
                        <Border x:Name="HoverLayer" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                CornerRadius="{ThemeResource ControlCornerRadius}" Opacity="0" />
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            Foreground="{TemplateBinding Foreground}"
                            TextWrapping="NoWrap" />
                        <!-- Selected indicator, as in the Fluent segmented control -->
                        <Border x:Name="Pill" Width="16" Height="3" CornerRadius="1.5" Margin="0,0,0,2"
                                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                Background="{ThemeResource AccentFillColorDefaultBrush}" Opacity="0" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="HoverLayer.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="HoverLayer.Opacity" Value="1" />
                                        <Setter Target="ContentPresenter.Opacity" Value="0.8" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="CheckedLayer.Opacity" Value="1" />
                                        <Setter Target="Pill.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon-only / compact segments (.view-action, .library-filter-group) -->
    <Style x:Key="ForgeCompactSegmentStyle" TargetType="RadioButton" BasedOn="{StaticResource ForgeSegmentStyle}">
        <Setter Property="Padding" Value="10,5,10,6" />
    </Style>

</ResourceDictionary>
