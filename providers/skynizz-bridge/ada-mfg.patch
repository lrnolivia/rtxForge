diff --git a/OptiScaler/framegen/dlssg/Companion.h b/OptiScaler/framegen/dlssg/Companion.h
new file mode 100644
index 0000000..a00c031
--- /dev/null
+++ b/OptiScaler/framegen/dlssg/Companion.h
@@ -0,0 +1,245 @@
+#pragma once
+
+#include <Config.h>
+#include <dlssnr/DlssNr.h>
+#include <cmath>
+#include <cstddef>
+#include <atomic>
+#include <mutex>
+#pragma comment(lib, "Advapi32.lib")
+
+// A local-session mailbox, not an overlay or an injection interface. Commands
+// contain only bounded numeric settings. The render thread owns Config and
+// publishes coherent snapshots; no worker thread touches graphics or Config.
+namespace ForgeCompanion
+{
+struct Mailbox
+{
+    LONG magic, version, pid, snapshot;
+    LONG command, acknowledged, result;
+    LONG enabled;
+    float intensity;
+    LONG multiplier, preSr, cache, interval, style;
+    float structure, tone;
+    LONG actualEnabled;
+    float actualIntensity;
+    LONG actualMultiplier, actualPreSr, actualCache, actualInterval, actualStyle;
+    float actualStructure, actualTone;
+    LONG nrRunning;
+    float nrMs, renderedFps;
+    LONG backendMax, lastGenerated, frames, fgSuccesses;
+    LONG preset, actualPreset;
+    LONG nativeStatus, nativePresented, stateSamples, stateTick;
+    LONG nativeMode, nativeGenerated;
+    char failure[96];
+    float workScale;
+    LONG passes;
+    float skin;
+    LONG autoMask;
+    float detail, colour;
+    LONG reduced, edgeAware;
+    float actualWorkScale;
+    LONG actualPasses;
+    float actualSkin;
+    LONG actualAutoMask;
+    float actualDetail, actualColour;
+    LONG actualReduced, actualEdgeAware;
+    LONG sharpen, sharpOverride, sharpenShader, motionSharpen;
+    float sharpness, motionSharpness;
+    LONG actualSharpen, actualSharpOverride, actualSharpenShader, actualMotionSharpen;
+    float actualSharpness, actualMotionSharpness;
+    LONG originalMenu, originalMenuKey;
+    char reserved[136];
+};
+static_assert(sizeof(Mailbox) == 512);
+static_assert(offsetof(Mailbox, workScale) == 256);
+static_assert(offsetof(Mailbox, actualWorkScale) == 288);
+static_assert(offsetof(Mailbox, actualSharpen) == 344);
+
+inline std::recursive_mutex guard;
+inline Mailbox* mailbox = nullptr;
+inline HANDLE mapping = nullptr;
+inline bool attempted = false;
+inline LONG observedFgSuccesses = 0;
+inline LONG observedGenerated = 0;
+inline LONG nativeStatus = -1, nativePresented = 0, stateSamples = 0, stateTick = 0;
+inline LONG nativeMode = -1, nativeGenerated = 0;
+
+// Record the native Streamline result before any compatibility reporting is
+// applied. A configured multiplier or successful NGX call is not a present.
+inline void ObservedDlssgState(LONG status, LONG presented)
+{
+    std::lock_guard lock(guard);
+    nativeStatus = status;
+    nativePresented = presented;
+    ++stateSamples;
+    stateTick = static_cast<LONG>(GetTickCount());
+}
+
+inline void ObservedDlssgOptions(LONG mode, LONG generated)
+{
+    std::lock_guard lock(guard);
+    nativeMode = mode;
+    nativeGenerated = generated;
+}
+
+inline void Completed(bool fg, NVSDK_NGX_Result result, NVSDK_NGX_Parameter* parameters)
+{
+    if (!fg || result != NVSDK_NGX_Result_Success)
+        return;
+    std::lock_guard lock(guard);
+    ++observedFgSuccesses;
+    int count = 0;
+    parameters->Get("DLSSG.MultiFrameCount", &count);
+    observedGenerated = count;
+}
+
+inline void Tick()
+{
+    std::lock_guard lock(guard);
+    if (!attempted)
+    {
+        attempted = true;
+        const auto name = L"Local\\rtxForge.controls." + std::to_wstring(GetCurrentProcessId());
+        mapping = CreateFileMappingW(INVALID_HANDLE_VALUE, nullptr, PAGE_READWRITE, 0, sizeof(Mailbox), name.c_str());
+        // Never consume a pre-existing mailbox supplied by another process.
+        if (mapping && GetLastError() != ERROR_ALREADY_EXISTS)
+            mailbox = static_cast<Mailbox*>(MapViewOfFile(mapping, FILE_MAP_ALL_ACCESS, 0, 0, sizeof(Mailbox)));
+        if (!mailbox)
+        {
+            if (mapping) CloseHandle(mapping);
+            mapping = nullptr;
+            return;
+        }
+        *mailbox = {};
+        mailbox->magic = 0x46585452;
+        mailbox->version = 5;
+        mailbox->pid = GetCurrentProcessId();
+    }
+    if (!mailbox) return;
+    auto& cfg = *Config::Instance();
+    // Read the per-user overlay choice once, before menu input is handled.
+    // Preserve the game's safe legacy/swapchain rendering choice. Switching
+    // menus is a next-launch preference, never a live hook reinitialization.
+    static const bool originalMenu = [] {
+        DWORD enabled = 0, bytes = sizeof(DWORD);
+        return RegGetValueW(HKEY_CURRENT_USER, L"Software\\rtxForge\\Overlay", L"UseOptiScaler",
+                            RRF_RT_REG_DWORD, nullptr, &enabled, &bytes) == ERROR_SUCCESS && enabled == 1;
+    }();
+    static const int menuKey = [] {
+        if (!originalMenu) return 0;
+        DWORD key = VK_INSERT, bytes = sizeof(DWORD);
+        RegGetValueW(HKEY_CURRENT_USER, L"Software\\rtxForge\\Overlay", L"ShortcutKey",
+                     RRF_RT_REG_DWORD, nullptr, &key, &bytes);
+        return key == VK_INSERT || key == VK_F8 ? static_cast<int>(key) : 0;
+    }();
+    cfg.ShortcutKey.set_volatile_value(menuKey);
+    const LONG sequence = InterlockedCompareExchange(&mailbox->command, 0, 0);
+    if (sequence > 0 && !(sequence & 1) && sequence != mailbox->acknowledged)
+    {
+        // Client marks an in-flight write odd and commits it even. Never read
+        // a partially written command, and validate every value before apply.
+        Mailbox request = *mailbox;
+        std::atomic_thread_fence(std::memory_order_seq_cst);
+        if (sequence == InterlockedCompareExchange(&mailbox->command, 0, 0))
+        {
+            const auto boolean = [](LONG n) { return n == 0 || n == 1; };
+            const auto bounded = [](float n, float lo, float hi) { return std::isfinite(n) && n >= lo && n <= hi; };
+            const bool valid = boolean(request.sharpen) && boolean(request.sharpOverride) && boolean(request.motionSharpen) &&
+                request.sharpenShader >= 0 && request.sharpenShader <= 2 &&
+                bounded(request.sharpness, 0.f, 1.f) && bounded(request.motionSharpness, 0.f, 1.f) &&
+                bounded(request.workScale, .25f, 2.f) && request.passes >= 1 && request.passes <= 3 &&
+                bounded(request.skin, -1.f, 2.f) && boolean(request.autoMask) &&
+                bounded(request.detail, 0.f, 2.f) && bounded(request.colour, 0.f, 4.f) &&
+                boolean(request.reduced) && boolean(request.edgeAware) && boolean(request.enabled) && boolean(request.preSr) && boolean(request.cache) &&
+                bounded(request.intensity, 0.f, 2.f) && bounded(request.structure, 0.f, 2.f) &&
+                bounded(request.tone, 0.f, 2.f) && request.interval >= 1 && request.interval <= 16 &&
+                request.style >= 0 && request.style <= 2 && request.preset >= 0 && request.preset <= 3 &&
+                (request.multiplier == -1 || request.multiplier == 0 || (request.multiplier >= 2 && request.multiplier <= 6));
+            auto& state = State::Instance();
+            const auto maximum = state.dlssgMfgMax.value_or(0);
+            const bool supported = request.multiplier <= 0 || maximum >= request.multiplier - 1;
+            mailbox->result = !valid ? 2 : !supported ? 3 : 1;
+            if (valid && supported)
+            {
+                cfg.RcasEnabled.set_volatile_value(request.sharpen != 0);
+                cfg.OverrideSharpness.set_volatile_value(request.sharpOverride != 0);
+                cfg.SharpnessShader.set_volatile_value(static_cast<SharpenShader>(request.sharpenShader));
+                cfg.MotionSharpnessEnabled.set_volatile_value(request.motionSharpen != 0);
+                cfg.Sharpness.set_volatile_value(request.sharpness);
+                cfg.MotionSharpness.set_volatile_value(request.motionSharpness);
+                cfg.DlssNrWorkingScale.set_volatile_value(request.workScale);
+                cfg.DlssNrPasses.set_volatile_value(request.passes);
+                cfg.DlssNrSkinStructure.set_volatile_value(request.skin);
+                cfg.DlssNrAutoMask.set_volatile_value(request.autoMask != 0);
+                cfg.DlssNrTransferStrength.set_volatile_value(request.detail);
+                cfg.DlssNrColourStrength.set_volatile_value(request.colour);
+                cfg.DlssNrPreSrReduced.set_volatile_value(request.reduced != 0);
+                cfg.DlssNrJbuUpsample.set_volatile_value(request.edgeAware != 0);
+                cfg.DlssNrEnabled.set_volatile_value(request.enabled != 0);
+                cfg.DlssNrIntensity.set_volatile_value(request.intensity);
+                cfg.DlssNrPreSr.set_volatile_value(request.preSr != 0);
+                cfg.DlssNrCacheEnabled.set_volatile_value(request.cache != 0);
+                cfg.DlssNrCacheInterval.set_volatile_value(request.interval);
+                cfg.DlssNrStyle.set_volatile_value(request.style);
+                cfg.DlssNrPreset.set_volatile_value(request.preset);
+                cfg.DlssNrLocalStructure.set_volatile_value(request.structure);
+                cfg.DlssNrLocalTone.set_volatile_value(request.tone);
+                if (request.multiplier == -1)
+                    cfg.FGDLSSGOverrideInterpolationCount = std::nullopt;
+                else
+                {
+                    const int generated = request.multiplier == 0 ? 0 : request.multiplier - 1;
+                    cfg.FGDLSSGOverrideInterpolationCount.set_volatile_value(generated);
+                    if (generated > 0) cfg.FGDLSSGInterpolationCount.set_volatile_value(generated);
+                }
+            }
+            InterlockedExchange(&mailbox->acknowledged, sequence);
+        }
+    }
+    InterlockedIncrement(&mailbox->snapshot);
+    mailbox->originalMenu = originalMenu;
+    mailbox->originalMenuKey = menuKey;
+    mailbox->actualWorkScale = cfg.DlssNrWorkingScale.value_or_default();
+    mailbox->actualSharpen = cfg.RcasEnabled.value_or_default();
+    mailbox->actualSharpOverride = cfg.OverrideSharpness.value_or_default();
+    mailbox->actualSharpenShader = static_cast<LONG>(cfg.SharpnessShader.value_or_default());
+    mailbox->actualMotionSharpen = cfg.MotionSharpnessEnabled.value_or_default();
+    mailbox->actualSharpness = cfg.Sharpness.value_or_default();
+    mailbox->actualMotionSharpness = cfg.MotionSharpness.value_or_default();
+    mailbox->actualPasses = cfg.DlssNrPasses.value_or_default();
+    mailbox->actualSkin = cfg.DlssNrSkinStructure.value_or_default();
+    mailbox->actualAutoMask = cfg.DlssNrAutoMask.value_or_default();
+    mailbox->actualDetail = cfg.DlssNrTransferStrength.value_or_default();
+    mailbox->actualColour = cfg.DlssNrColourStrength.value_or_default();
+    mailbox->actualReduced = cfg.DlssNrPreSrReduced.value_or_default();
+    mailbox->actualEdgeAware = cfg.DlssNrJbuUpsample.value_or_default();
+    mailbox->actualEnabled = cfg.DlssNrEnabled.value_or_default();
+    mailbox->actualIntensity = cfg.DlssNrIntensity.value_or_default();
+    auto count = cfg.FGDLSSGOverrideInterpolationCount;
+    mailbox->actualMultiplier = !count.has_value() ? -1 : count.value() == 0 ? 0 : count.value() + 1;
+    mailbox->actualPreSr = cfg.DlssNrPreSr.value_or_default();
+    mailbox->actualCache = cfg.DlssNrCacheEnabled.value_or_default();
+    mailbox->actualInterval = cfg.DlssNrCacheInterval.value_or_default();
+    mailbox->actualStyle = cfg.DlssNrStyle.value_or_default();
+    mailbox->actualStructure = cfg.DlssNrLocalStructure.value_or_default();
+    mailbox->actualTone = cfg.DlssNrLocalTone.value_or_default();
+    mailbox->actualPreset = cfg.DlssNrPreset.value_or_default();
+    const auto live = DlssNr::GetLiveStats();
+    mailbox->nrRunning = cfg.DlssNrEnabled.value_or_default() && DlssNr::IsRunning();
+    mailbox->nrMs = static_cast<float>(live.nrMs);
+    mailbox->renderedFps = static_cast<float>(live.renderedFps);
+    mailbox->backendMax = State::Instance().dlssgMfgMax.value_or(0);
+    mailbox->lastGenerated = observedGenerated;
+    mailbox->fgSuccesses = observedFgSuccesses;
+    mailbox->nativeStatus = nativeStatus;
+    mailbox->nativePresented = nativePresented;
+    mailbox->stateSamples = stateSamples;
+    mailbox->stateTick = stateTick;
+    mailbox->nativeMode = nativeMode;
+    mailbox->nativeGenerated = nativeGenerated;
+    ++mailbox->frames;
+    strncpy_s(mailbox->failure, DlssNr::FailureReason(), _TRUNCATE);
+    InterlockedIncrement(&mailbox->snapshot);
+}
+}
diff --git a/OptiScaler/framegen/dlssg/MfgUnlock.cpp b/OptiScaler/framegen/dlssg/MfgUnlock.cpp
new file mode 100644
index 0000000..3fca66d
--- /dev/null
+++ b/OptiScaler/framegen/dlssg/MfgUnlock.cpp
@@ -0,0 +1,408 @@
+#include "pch.h"
+
+#include "MfgUnlock.h"
+
+#include <Config.h>
+#include <Util.h>
+#include <scanner/scanner.h>
+#include <misc/IdentifyGpu.h>
+#include <proxies/Ntdll_Proxy.h>
+#include <map>
+#include <mutex>
+
+
+namespace
+{
+// mov ebx,1 / mov r8d,3 / cmp edi,0x1b0 / cmovl r8d,ebx. The two counts and the architecture
+// constant together are unique in the module; the wildcards cover nothing, they are here only to
+// keep the shape readable.
+constexpr std::string_view kAdvertisePattern = "BB 01 00 00 00 41 B8 03 00 00 00 81 FF B0 01 00 00 44 0F 4C C3";
+
+// cmp eax,0x1b0 / jl / cmp ebx,3 / jbe. The only comparison against the architecture constant that
+// is followed by a signed branch and a count test.
+constexpr std::string_view kValidatePattern = "3D B0 01 00 00 7C ? 83 FB 03 76";
+
+// Five generated frames, the count both patched sites carry.
+constexpr uint8_t kMaxGeneratedFrames = 5;
+
+// 310.9 restructured both gates. The count is no longer an immediate next to the comparison: the
+// Blackwell branch starts at five and reads a configured value, and anything below Blackwell is sent
+// to a branch that publishes one.
+//     cmp ebp, 0x1b0
+//     jl  ada          <- neutralised, so every card takes the Blackwell branch
+//     mov edi, 0x5
+constexpr std::string_view kAdvertisePattern309 = "81 FD B0 01 00 00 0F 8C ? ? ? ? BF 05 00 00 00";
+
+// The capability flag in the same build is a setae rather than a branch.
+//     cmp   eax, 0x1b0
+//     setae al
+constexpr std::string_view kValidatePattern309 = "3D B0 01 00 00 0F 93 C0";
+
+
+
+// scanner::GetAddress only walks sections marked executable. Fatbins are data, so they need their own
+// search. Returns 0 unless exactly one non-executable section holds the sequence, once.
+uintptr_t FindDataBytes(HMODULE module, const uint8_t* needle, size_t length)
+{
+    auto base = reinterpret_cast<uint8_t*>(module);
+    auto dos = reinterpret_cast<IMAGE_DOS_HEADER*>(base);
+    auto nt = reinterpret_cast<IMAGE_NT_HEADERS64*>(base + dos->e_lfanew);
+    auto section = IMAGE_FIRST_SECTION(nt);
+
+    uintptr_t found = 0;
+    size_t hits = 0;
+
+    for (unsigned i = 0; i < nt->FileHeader.NumberOfSections; ++i)
+    {
+        const auto& s = section[i];
+
+        if (s.Characteristics & IMAGE_SCN_MEM_EXECUTE)
+            continue;
+
+        uint8_t* start = base + s.VirtualAddress;
+        uint8_t* end = start + s.Misc.VirtualSize;
+
+        for (uint8_t* p = std::search(start, end, needle, needle + length); p != end;
+             p = std::search(p + 1, end, needle, needle + length))
+        {
+            found = reinterpret_cast<uintptr_t>(p);
+
+            if (++hits > 1)
+                return 0;
+        }
+    }
+
+    return hits == 1 ? found : 0;
+}
+
+MfgUnlock::Status g_status {};
+std::recursive_mutex g_patchMutex;
+std::map<HMODULE, MfgUnlock::Status> g_modules;
+
+// The module's own file version, for the report. A signature that does not match is expected on a
+// version nobody has looked at, and the version is the one thing that makes such a report actionable.
+std::string ModuleVersion(HMODULE module)
+{
+    wchar_t path[MAX_PATH] {};
+
+    if (GetModuleFileNameW(module, path, MAX_PATH) == 0)
+        return {};
+
+    version_t file {};
+    version_t product {};
+
+    if (!Util::GetFileVersion(path, &file, &product))
+        return {};
+
+    return std::format("{}.{}.{}", file.major, file.minor, file.patch);
+}
+
+bool WriteBytes(uintptr_t address, const uint8_t* bytes, size_t count)
+{
+    DWORD oldProtect = 0;
+
+    if (!VirtualProtect((LPVOID) address, count, PAGE_EXECUTE_READWRITE, &oldProtect))
+    {
+        LOG_WARN("VirtualProtect failed at {:X}", address);
+        return false;
+    }
+
+    std::memcpy((void*) address, bytes, count);
+
+    DWORD ignored = 0;
+    VirtualProtect((LPVOID) address, count, oldProtect, &ignored);
+    FlushInstructionCache(GetCurrentProcess(), (LPCVOID) address, count);
+
+    return true;
+}
+
+std::string Hex(const uint8_t* bytes, size_t count)
+{
+    std::string out;
+
+    for (size_t i = 0; i < count; ++i)
+        out += std::format("{}{:02X}", i == 0 ? "" : " ", bytes[i]);
+
+    return out;
+}
+
+// Rewrites count and neutralises the architecture clamp, so MultiFrameCountMax is published as five.
+bool PatchAdvertise(HMODULE module)
+{
+    if (const auto at309 = scanner::GetAddress(module, kAdvertisePattern309); at309 != 0)
+    {
+        // The jl is a rel32, six bytes.
+        const auto branchAt = at309 + 6;
+        const uint8_t nop[] = { 0x0F, 0x1F, 0x44, 0x00, 0x00, 0x90 };
+
+        LOG_INFO("MFG unlock: advertise (310.9) at {:X}, jl {} -> {}", at309,
+                 Hex((const uint8_t*) branchAt, sizeof(nop)), Hex(nop, sizeof(nop)));
+
+        return WriteBytes(branchAt, nop, sizeof(nop));
+    }
+
+    const auto address = scanner::GetAddress(module, kAdvertisePattern);
+
+    if (address == 0)
+    {
+        LOG_WARN("MFG unlock: the advertise signature did not match, nvngx_dlssg.dll left alone");
+        return false;
+    }
+
+    // Offsets within the matched sequence: the r8d immediate, and the cmovl.
+    const auto countAt = address + 7;
+    const auto cmovAt = address + 17;
+
+    const uint8_t count[] = { kMaxGeneratedFrames };
+    const uint8_t nop[] = { 0x0F, 0x1F, 0x40, 0x00 };
+
+    LOG_INFO("MFG unlock: advertise at {:X}, count {} -> {}, cmovl {} -> {}", address,
+             *(const uint8_t*) countAt, kMaxGeneratedFrames, Hex((const uint8_t*) cmovAt, sizeof(nop)),
+             Hex(nop, sizeof(nop)));
+
+    return WriteBytes(countAt, count, sizeof(count)) && WriteBytes(cmovAt, nop, sizeof(nop));
+}
+
+// Drops the Ada branch and raises the accepted count, so a request for five is not rejected.
+bool PatchValidate(HMODULE module)
+{
+    if (const auto at309 = scanner::GetAddress(module, kValidatePattern309); at309 != 0)
+    {
+        // setae al -> mov al, 1, so the flag is set whatever the architecture reports.
+        const auto setAt = at309 + 5;
+        const uint8_t always[] = { 0xB0, 0x01, 0x90 };
+
+        LOG_INFO("MFG unlock: validate (310.9) at {:X}, setae {} -> {}", at309,
+                 Hex((const uint8_t*) setAt, sizeof(always)), Hex(always, sizeof(always)));
+
+        return WriteBytes(setAt, always, sizeof(always));
+    }
+
+    const auto address = scanner::GetAddress(module, kValidatePattern);
+
+    if (address == 0)
+    {
+        LOG_WARN("MFG unlock: the validate signature did not match, nvngx_dlssg.dll left alone");
+        return false;
+    }
+
+    // Offsets within the matched sequence: the jl, and the immediate of the count test behind it.
+    const auto branchAt = address + 5;
+    const auto countAt = address + 9;
+
+    const uint8_t nop[] = { 0x90, 0x90 };
+    const uint8_t count[] = { kMaxGeneratedFrames };
+
+    LOG_INFO("MFG unlock: validate at {:X}, jl {} -> {}, count {} -> {}", address,
+             Hex((const uint8_t*) branchAt, sizeof(nop)), Hex(nop, sizeof(nop)), *(const uint8_t*) countAt,
+             kMaxGeneratedFrames);
+
+    return WriteBytes(branchAt, nop, sizeof(nop)) && WriteBytes(countAt, count, sizeof(count));
+}
+
+
+// Gives Ada the Blackwell kernels the module already carries.
+//
+// nvngx_dlssg.dll ships two builds of the interpolation kernels. Kernel_EstimateIntermMvecsScatter
+// reads three f32 fields of its parameter block on sm_120 and one on sm_89, so on Ada every generated
+// frame is placed at the same point between the two real ones: the world does not advance between
+// them while the interface, composited once per present, does. At 2X there is one frame and nothing
+// to distinguish; above it that is the whole symptom.
+//
+// The sm_120 module uses no instruction Ada lacks. So per container: the Blackwell PTX image is
+// relabelled sm_89, its .target directive is rewritten in place (".target sm_120" and
+// ".target sm_89 " are both fourteen bytes, and the directive sits in the literal run at the head of
+// the LZ4 stream), and the images that were sm_89 -- the Ada PTX and its SASS -- are relabelled to an
+// architecture that does not exist so the driver cannot select them. The driver then JITs Blackwell's
+// kernel when it asks for Ada's.
+//
+// Nothing is copied in and no payload changes length. A container without both images is left alone.
+constexpr uint32_t kArchAda = 89;
+constexpr uint32_t kArchBlackwell = 120;
+
+// No such shader model. Parks an image where nothing will ask for it.
+constexpr uint32_t kArchParked = 122;
+
+// Offsets inside a fatbin image header: payload length, and the architecture the image answers for.
+constexpr size_t kImagePayloadSize = 8;
+constexpr size_t kImageArch = 28;
+
+unsigned int RewriteBlackwellKernels(HMODULE module)
+{
+    auto base = reinterpret_cast<uint8_t*>(module);
+    auto dos = reinterpret_cast<IMAGE_DOS_HEADER*>(base);
+    auto nt = reinterpret_cast<IMAGE_NT_HEADERS64*>(base + dos->e_lfanew);
+    auto section = IMAGE_FIRST_SECTION(nt);
+
+    const uint8_t magic[] = { 0x50, 0xED, 0x55, 0xBA };
+    unsigned int rewritten = 0;
+
+    for (unsigned i = 0; i < nt->FileHeader.NumberOfSections; ++i)
+    {
+        const auto& s = section[i];
+
+        if (s.Characteristics & IMAGE_SCN_MEM_EXECUTE)
+            continue;
+
+        uint8_t* start = base + s.VirtualAddress;
+        uint8_t* end = start + s.Misc.VirtualSize;
+
+        for (uint8_t* c = std::search(start, end, magic, magic + sizeof(magic)); c < end;
+             c = std::search(c + 1, end, magic, magic + sizeof(magic)))
+        {
+            if (c + 16 > end)
+                break;
+
+            const auto headerSize = *reinterpret_cast<const uint16_t*>(c + 6);
+            const auto fatSize = *reinterpret_cast<const uint64_t*>(c + 8);
+
+            if (headerSize != 0x10 || fatSize == 0 || c + 16 + fatSize > end)
+                continue;
+
+            uint8_t* blackwell = nullptr;
+            size_t blackwellHeader = 0;
+            size_t blackwellPayload = 0;
+            std::vector<uint8_t*> ada;
+
+            for (uint8_t* image = c + 16; image < c + 16 + fatSize;)
+            {
+                const auto kind = *reinterpret_cast<const uint16_t*>(image);
+                const auto imageHeader = *reinterpret_cast<const uint32_t*>(image + 4);
+                const auto payload = *reinterpret_cast<const uint64_t*>(image + kImagePayloadSize);
+                const auto arch = *reinterpret_cast<const uint32_t*>(image + kImageArch);
+
+                if (imageHeader == 0 || payload == 0)
+                    break;
+
+                // kind 1 is PTX, 2 is a cubin. Only the PTX can be retargeted; the cubin is parked.
+                if (kind == 1 && arch == kArchBlackwell)
+                {
+                    blackwell = image;
+                    blackwellHeader = imageHeader;
+                    blackwellPayload = payload;
+                }
+                else if (arch == kArchAda)
+                {
+                    ada.push_back(image);
+                }
+
+                image += imageHeader + payload;
+            }
+
+            if (blackwell == nullptr || ada.empty())
+                continue;
+
+            const char from[] = ".target sm_120";
+            const char to[] = ".target sm_89 ";
+            static_assert(sizeof(from) == sizeof(to), "the directive rewrite must not change length");
+
+            uint8_t* body = blackwell + blackwellHeader;
+            uint8_t* bodyEnd = body + blackwellPayload;
+            auto at = std::search(body, bodyEnd, from, from + sizeof(from) - 1);
+
+            if (at == bodyEnd)
+                continue;
+
+            if (!WriteBytes(reinterpret_cast<uintptr_t>(at), reinterpret_cast<const uint8_t*>(to),
+                            sizeof(to) - 1))
+                continue;
+
+            const uint32_t ada89 = kArchAda;
+            const uint32_t parked = kArchParked;
+
+            WriteBytes(reinterpret_cast<uintptr_t>(blackwell + kImageArch),
+                       reinterpret_cast<const uint8_t*>(&ada89), sizeof(ada89));
+
+            for (uint8_t* image : ada)
+                WriteBytes(reinterpret_cast<uintptr_t>(image + kImageArch),
+                           reinterpret_cast<const uint8_t*>(&parked), sizeof(parked));
+
+            ++rewritten;
+        }
+    }
+
+    LOG_INFO("MFG unlock: {} kernel containers answer Ada with the Blackwell image", rewritten);
+
+    return rewritten;
+}
+} // namespace
+
+void MfgUnlock::TryApply(HMODULE module)
+{
+    if (!Config::Instance()->FGDLSSGAdaMfgUnlock.value_or_default())
+        return;
+
+    if (module == nullptr)
+        module = GetModuleHandleW(L"nvngx_dlssg.dll");
+
+    if (module == nullptr)
+        return;
+
+    std::scoped_lock lock(g_patchMutex);
+    auto [entry, inserted] = g_modules.try_emplace(module);
+    if (!inserted)
+        return;
+
+    auto& status = entry->second;
+    status.ModuleFound = true;
+    status.SnippetVersion = ModuleVersion(module);
+    status.AdvertiseMatched = PatchAdvertise(module);
+    status.ValidateMatched = PatchValidate(module);
+
+    const auto& gpu = IdentifyGpu::getPrimaryGpu();
+    const bool preBlackwell = gpu.vendorId == VendorId::Nvidia &&
+                              gpu.nvidiaArchInfo.architecture_id >= NV_GPU_ARCHITECTURE_TU100 &&
+                              gpu.nvidiaArchInfo.architecture_id <= NV_GPU_ARCHITECTURE_AD100;
+
+    if (Config::Instance()->FGDLSSGAdaBlackwellKernels.value_or(preBlackwell))
+        status.KernelsRewritten = RewriteBlackwellKernels(module);
+
+    // A successful native copy must not mask a failed private copy.
+    g_status = {};
+    g_status.ModuleFound = true;
+    g_status.AdvertiseMatched = true;
+    g_status.ValidateMatched = true;
+    g_status.SnippetVersion = status.SnippetVersion;
+    for (const auto& [handle, result] : g_modules)
+    {
+        g_status.AdvertiseMatched &= result.AdvertiseMatched;
+        g_status.ValidateMatched &= result.ValidateMatched;
+        g_status.KernelsRewritten += result.KernelsRewritten;
+    }
+
+    if (status.AdvertiseMatched && status.ValidateMatched)
+        LOG_INFO("MFG unlock: module {:X} patched for {} generated frames ({} modules)",
+                 reinterpret_cast<uintptr_t>(module), kMaxGeneratedFrames, g_modules.size());
+    else
+        LOG_WARN("MFG unlock: module {:X} incomplete, advertise {}, validate {}",
+                 reinterpret_cast<uintptr_t>(module), status.AdvertiseMatched, status.ValidateMatched);
+}
+
+void MfgUnlock::PreparePrivateRuntime()
+{
+    if (!Config::Instance()->FGDLSSGAdaMfgUnlock.value_or_default())
+        return;
+
+    const auto path = std::filesystem::path(Config::Instance()->MainDllPath.value()) / L"nvngx_dlssg.dll";
+    if (!std::filesystem::is_regular_file(path))
+        return;
+
+    auto module = GetModuleHandleW(path.c_str());
+    if (module == nullptr)
+        module = NtdllProxy::LoadLibraryExW_Ldr(path.c_str(), nullptr, 0);
+
+    if (module != nullptr)
+        TryApply(module);
+    else
+        LOG_WARN("MFG unlock: private runtime could not be loaded before NGX initialization");
+}
+
+unsigned int MfgUnlock::UnlockedMax()
+{
+    std::scoped_lock lock(g_patchMutex);
+    const auto& status = LastStatus();
+
+    return status.AdvertiseMatched && status.ValidateMatched ? kMaxGeneratedFrames : 0;
+}
+
+const MfgUnlock::Status& MfgUnlock::LastStatus() { return g_status; }
