+    def _column_schedule_height_refresh(self):
+        if getattr(
+            self,
+            '_column_height_refresh_source',
+            0,
+        ):
+            return
+
+        self._column_height_refresh_source=GLib.idle_add(
+            self._column_refresh_name_heights
+        )
+
+
+    def _column_refresh_name_heights(self):
+        self._column_height_refresh_source=0
+
+        for root in list(
+            self.list_name_cells.values()
+        ):
+            if getattr(
+                root,
+                '_game',
+                None,
+            ) is not None:
+                self._column_update_name_height(
+                    root
+                )
+
+        return False
+
+
+    def _column_update_name_height(
+        self,
+        root,
+    ):
+        """ColumnView rows have exactly two possible heights."""
+
+        game=getattr(
+            root,
+            '_game',
+            None,
+        )
+
+        if game is None:
+            return
+
+        width=self.list_name_column.get_fixed_width()
+
+        if width<=0:
+            width=460
+
+        width=max(
+            340,
+            min(
+                560,
+                width,
+            ),
+        )
+
+        # Approximate usable title width after:
+        # checkbox + gaps + 100px capsule + internal padding.
+        title_width=max(
+            118,
+            width-166,
+        )
+
+        name=str(
+            game.get(
+                'name',
+                '',
+            )
+        )
+
+        layout=root._title.create_pango_layout(
+            name
+        )
+
+        # Measure as a single unwrapped line first.
+        layout.set_width(
+            -1
+        )
+
+        (
+            natural_width,
+            _natural_height,
+        )=layout.get_pixel_size()
+
+        wraps=(
+            natural_width
+            > title_width
+        )
+
+        # Never more than two lines.
+        root._title.set_wrap(
+            True
+        )
+        root._title.set_wrap_mode(
+            Pango.WrapMode.WORD_CHAR
+        )
+        root._title.set_lines(
+            2
+        )
+        root._title.set_single_line_mode(
+            False
+        )
+        root._title.set_ellipsize(
+            Pango.EllipsizeMode.END
+        )
+
+        # Exactly two possible row heights:
+        #
+        #   60px normal
+        #   90px wrapped (1.5x)
+        #
+        # No title can ever make the table taller than this.
+        root.set_size_request(
+            -1,
+            90 if wraps else 60,
+        )
+
+        root.queue_resize()
 
 
