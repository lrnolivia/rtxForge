{
  "name": "rtxforge-game-mode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort --configLoader native",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 1420 --strictPort",
    "tauri": "tauri",
    "check": "node --test tests/*.test.mjs",
    "check:ui": "node tests/ui.mjs",
    "check:contracts": "node tests/contracts.mjs",
    "check:appearance": "node tests/appearance.mjs",
    "check:presets": "node tests/presets.mjs",
    "check:settings": "node tests/settings.mjs",
    "check:library": "node tests/library.mjs",
    "check:library-visual": "node tests/library-visual.mjs",
    "check:controls": "node tests/controls.mjs",
    "check:polish": "node tests/ui-polish.mjs",
    "check:install": "node tests/install-flow.mjs",
    "check:controller": "node tests/controller.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.9.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0"
  }
}
