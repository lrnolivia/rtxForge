<Application
    x:Class="RtxForge.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <ResourceDictionary Source="ms-appx:///Themes/Controls.xaml" />
                <ResourceDictionary Source="ms-appx:///Themes/GameMode.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                GeForce accent mapped onto the Fluent accent ramp, so every
                stock WinUI control (ToggleSwitch, Slider, accent Button,
                NavigationView selection pill) picks it up automatically.
                Linux source: @accent_bg_color #76b900, @accent_color #95cf38.
            -->
            <Color x:Key="SystemAccentColor">#FF76B900</Color>
            <Color x:Key="SystemAccentColorLight1">#FF86C51C</Color>
            <Color x:Key="SystemAccentColorLight2">#FF95CF38</Color>
            <Color x:Key="SystemAccentColorLight3">#FFB4E070</Color>
            <Color x:Key="SystemAccentColorDark1">#FF437500</Color>
            <Color x:Key="SystemAccentColorDark2">#FF376B18</Color>
            <Color x:Key="SystemAccentColorDark3">#FF315B15</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
