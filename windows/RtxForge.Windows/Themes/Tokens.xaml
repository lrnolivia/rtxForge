<!--
    rtxForge design tokens for WinUI 3.

    Surfaces, geometry, typography ramp and control fills are native Fluent
    (Mica, Layer/Card fills, ControlCornerRadius, OverlayCornerRadius). Only
    rtxForge's brand colors and the status colors from the Linux CSS
    (gui/rtxforge_gtk.py) are defined here. The full map lives in
    windows/DESIGN-MAP.md.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Default">
            <!-- .eyebrow #76b900 -->
            <SolidColorBrush x:Key="ForgeEyebrowBrush" Color="#FF76B900" />
            <!-- .bulk-remove #ff928c -->
            <SolidColorBrush x:Key="ForgeRemoveBrush" Color="#FFFF928C" />
            <!-- .library-test-pill.test-tested / .library-pill-icon -->
            <SolidColorBrush x:Key="ForgePillTestedBrush" Color="#FF76B900" />
            <SolidColorBrush x:Key="ForgePillIconBrush" Color="#FFBFBFBF" />
            <!-- .banner-shade, fading into the dark Mica content layer -->
            <LinearGradientBrush x:Key="ForgeBannerShadeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#14202020" Offset="0" />
                <GradientStop Color="#4D202020" Offset="0.28" />
                <GradientStop Color="#B8202020" Offset="0.52" />
                <GradientStop Color="#F0202020" Offset="0.76" />
                <GradientStop Color="#FF202020" Offset="1" />
            </LinearGradientBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <!-- light override: .eyebrow #437500 -->
            <SolidColorBrush x:Key="ForgeEyebrowBrush" Color="#FF437500" />
            <!-- light override: .bulk-remove #9b3028 -->
            <SolidColorBrush x:Key="ForgeRemoveBrush" Color="#FF9B3028" />
            <SolidColorBrush x:Key="ForgePillTestedBrush" Color="#FF315B15" />
            <SolidColorBrush x:Key="ForgePillIconBrush" Color="#FF6B6B6B" />
            <LinearGradientBrush x:Key="ForgeBannerShadeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#14F3F3F3" Offset="0" />
                <GradientStop Color="#4DF3F3F3" Offset="0.28" />
                <GradientStop Color="#B8F3F3F3" Offset="0.52" />
                <GradientStop Color="#F0F3F3F3" Offset="0.76" />
                <GradientStop Color="#FFF3F3F3" Offset="1" />
            </LinearGradientBrush>
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- Bakbak One is shared with Linux via a linked Content item. -->
    <FontFamily x:Key="ForgeHeroFontFamily">ms-appx:///Assets/Fonts/BakbakOne-Regular.ttf#Bakbak One</FontFamily>
    <x:Double x:Key="ForgeHeroTitleFontSize">30</x:Double>
    <x:Double x:Key="ForgeEyebrowFontSize">9</x:Double>
    <x:Double x:Key="ForgeBannerTitleFontSize">42</x:Double>

    <!-- Game art keeps rtxForge's rounder shape (Linux .game-card 14px). -->
    <CornerRadius x:Key="ForgeCardCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="ForgeArtCornerRadius">8</CornerRadius>

</ResourceDictionary>
