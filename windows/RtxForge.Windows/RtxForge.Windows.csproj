<Project Sdk="Microsoft.NET.Sdk">

  <!--
    rtxForge for Windows: native WinUI 3 shell.

    Mirrors the Linux libadwaita desktop build (gui/rtxforge_gtk.py) screen for
    screen. Game Mode (gui/couch_shell.py) is being ported; its settings are already here.
    Shared product assets are linked from the repository instead of copied.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>RtxForge.Windows</RootNamespace>
    <AssemblyName>rtxForge</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Generated from gui/icons/hicolor (16–256 px PNG frames) by the MakeIcon target; used for the exe, window, taskbar and setup. -->
    <ApplicationIcon>Assets\rtxforge.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Unpackaged apps still need the MSIX tooling to emit rtxForge.pri and the compiled .xbf XAML on publish. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Product>rtxForge</Product>
    <Company>loew.fi</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
  </ItemGroup>

  <!-- Shared brand assets: one source of truth with the Linux build. -->
  <ItemGroup>
    <Content Include="Assets\Fonts\InterVariable.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Fonts\OFL-Inter.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\gui\fonts\BakbakOne-Regular.ttf" Link="Assets\Fonts\BakbakOne-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\gui\fonts\OFL-BakbakOne.txt" Link="Assets\Fonts\OFL-BakbakOne.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\gui\icons\rtxforge-mark.svg" Link="Assets\rtxforge-mark.svg" CopyToOutputDirectory="PreserveNewest" />
    <!-- Both generated by the MakeIcon target from gui/icons/hicolor/scalable. -->
    <Content Include="Assets\rtxforge-icon.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\rtxforge.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\VERSION" Link="VERSION" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    Build scripts run in Windows PowerShell 5.1 with its own module path: started
    from PowerShell 7 (as CI steps are) it would inherit 7's modules and lose
    Get-FileHash and Expand-Archive.
  -->
  <PropertyGroup>
    <WindowsPowerShellEnvironment>PSModulePath=$(SystemRoot)\System32\WindowsPowerShell\v1.0\Modules</WindowsPowerShellEnvironment>
  </PropertyGroup>

  <!-- The icon is built, not checked in, so the brand PNGs stay the single source. -->
  <Target Name="MakeIcon" BeforeTargets="PrepareForBuild"
          Condition="!Exists('$(MSBuildProjectDirectory)\Assets\rtxforge.ico') Or !Exists('$(MSBuildProjectDirectory)\Assets\rtxforge-icon.png')">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\build\Make-Icon.ps1&quot; -Output &quot;$(MSBuildProjectDirectory)\Assets\rtxforge.ico&quot; -PngOutput &quot;$(MSBuildProjectDirectory)\Assets\rtxforge-icon.png&quot;"
          EnvironmentVariables="$(WindowsPowerShellEnvironment)" />
  </Target>

  <!--
    Published builds carry the engine and a private Python (python.org
    embeddable package), so users install nothing. Dev builds use the
    repository and a local Python instead (EngineForgeService.FindEngineRoot).
  -->
  <Target Name="BundleEngine" AfterTargets="Publish" Condition="'$(RuntimeIdentifier)' != ''">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\build\Bundle-Engine.ps1&quot; -Output &quot;$(PublishDir.TrimEnd('\'))&quot; -RuntimeIdentifier $(RuntimeIdentifier)"
          EnvironmentVariables="$(WindowsPowerShellEnvironment)" />
  </Target>

</Project>
