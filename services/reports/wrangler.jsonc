// rtxforge-reports: deployed from lrnolivia/rtxForge main by Workers Builds (root: services/reports).
// Secrets, set in Cloudflare and never here: RTXFORGE_REPORTS_APP_ID,
// RTXFORGE_REPORTS_INSTALLATION_ID, RTXFORGE_REPORTS_PRIVATE_KEY, and TURNSTILE_SECRET (website reports).
{
  "name": "rtxforge-reports",
  "account_id": "8df30cd302a4d4a4c01db9863c712166",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  // More specific than the website's loew.fi/rtxforge*, so it wins for this path only.
  "routes": [
    { "pattern": "loew.fi/rtxforge/api/report*", "zone_name": "loew.fi" }
  ],
  // Private: no public bucket access and no r2.dev URL.
  "r2_buckets": [
    { "binding": "LOGS", "bucket_name": "rtxforge-report-logs" }
  ],
  "ratelimits": [
    { "name": "LIMITER", "namespace_id": "4101", "simple": { "limit": 3, "period": 60 } },
    { "name": "GLOBAL_LIMITER", "namespace_id": "4102", "simple": { "limit": 30, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
