<Page
    x:Class="RtxForge.Windows.Views.PlaceholderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Packages / Extras until the Windows engine bridge lands. -->
    <Grid Padding="36,12,36,36" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Style="{StaticResource ForgePageTitleTextStyle}" />
        <StackPanel Grid.Row="1" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
            <FontIcon x:Name="Icon" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="Description" Style="{StaticResource ForgeDimTextStyle}" TextAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
