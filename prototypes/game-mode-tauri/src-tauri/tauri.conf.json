{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rtxForge Game Mode Prototype",
  "version": "0.1.0",
  "identifier": "fi.loew.rtxforge.gamemode.prototype",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js --host 127.0.0.1 --port 1420 --strictPort --configLoader native",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "rtxForge · Game Mode", "width": 1440, "height": 960, "minWidth": 390, "minHeight": 600, "backgroundColor": "#292b2b" }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://cdn2.steamgriddb.com https://cdn.steamgriddb.com https://shared.akamai.steamstatic.com; font-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "resources": { "../bridge/read_snapshot.py": "bridge/read_snapshot.py", "../bridge/engine_host.py": "bridge/engine_host.py", "../bridge/linux_host.py": "bridge/linux_host.py", "../bridge/review_routes.py": "bridge/review_routes.py" }
  }
}
