 bool ShouldBlockKeyboardInputLocked() { return ShouldApplyBlockingPolicyLocked() && _state.BlockKeyboard; }
 
+// The reserved shortcut opens an overlay, so the game must not also act on it
+// (Starfield opens its console on the same key). A press counts only with the
+// shortcut's modifiers; the key stays hidden until it is released.
+bool IsReservedKeyPressLocked(int vk)
+{
+    if (bypassHookDepth != 0 || !_state.Focused || vk <= 0 || vk != _state.ReservedKey)
+        return false;
+
+    if (_state.ReservedKeyHeld)
+        return true;
+
+    const int held = ((RealGetAsyncKeyStateSafe(VK_MENU) & 0x8000) ? 1 : 0) |
+                     ((RealGetAsyncKeyStateSafe(VK_CONTROL) & 0x8000) ? 2 : 0) |
+                     ((RealGetAsyncKeyStateSafe(VK_SHIFT) & 0x8000) ? 4 : 0);
+
+    _state.ReservedKeyHeld = held == _state.ReservedModifiers;
+    return _state.ReservedKeyHeld;
+}
+
+bool IsReservedKeyHeldLocked(int vk)
+{
+    return bypassHookDepth == 0 && vk > 0 && vk == _state.ReservedKey && _state.ReservedKeyHeld;
+}
+
+// The character TranslateMessage made from a hidden press of the reserved key.
+bool IsReservedCharLocked(LPARAM lParam)
+{
+    const int vk = _state.ReservedKey;
+
+    if (bypassHookDepth != 0 || vk <= 0 || !_state.Keys[vk].BlockedDown)
+        return false;
+
+    return ((static_cast<UINT>(lParam) >> 16) & 0xFF) == MapVirtualKeyW(static_cast<UINT>(vk), MAPVK_VK_TO_VSC);
+}
+
+void ReleaseReservedKeyLocked(int vk)
+{
+    if (vk == _state.ReservedKey)
+        _state.ReservedKeyHeld = false;
+}
+
 bool ShouldBlockMouseInputLocked() { return ShouldApplyBlockingPolicyLocked() && _state.BlockMouse; }
 
 bool ShouldBlockCursorInputLocked() { return ShouldApplyBlockingPolicyLocked() && _state.BlockCursor; }
