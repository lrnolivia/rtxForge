<Window
    x:Class="RtxForge.Windows.Views.CompanionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="rtxForge · Live controls">
    <Grid x:Name="Root" RequestedTheme="Dark" Background="Transparent">
        <Grid.Resources>
            <SolidColorBrush x:Key="PanelSecondary" Color="#C4CAD0" />
            <Style x:Key="PanelCaption" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource PanelSecondary}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="PanelHeading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="PanelPlate" TargetType="Border">
                <Setter Property="Background" Value="#D12C3035" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="20" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="DragBar" Margin="24,0,64,0">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="rtxForge" FontFamily="{StaticResource ForgeHeroFontFamily}" FontSize="18" />
                <TextBlock Text="Live controls" Style="{StaticResource PanelCaption}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
        <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" Width="36" Height="32"
                Background="Transparent" BorderThickness="0" Click="OnHide" AutomationProperties.Name="Hide live controls" ToolTipService.ToolTip="Hide panel">
            <FontIcon Glyph="&#xE8BB;" FontSize="12" />
        </Button>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
            <StackPanel Padding="24,8,24,24" Spacing="16">
                <StackPanel Spacing="8">
                    <ComboBox x:Name="GamePicker" HorizontalAlignment="Stretch" DisplayMemberPath="Name" SelectionChanged="OnGameChanged"
                              AutomationProperties.Name="Game controlled by this panel" />
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse x:Name="ConnectionDot" Width="6" Height="6" Fill="#ADB4BC" />
                        <TextBlock x:Name="ConnectionText" Text="Choose a game" Style="{StaticResource PanelCaption}" />
                    </StackPanel>
                    <TextBlock x:Name="ConnectionDetail" Style="{StaticResource PanelCaption}" />
                </StackPanel>

                <Border Style="{StaticResource PanelPlate}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Multi Frame Generation" Style="{StaticResource PanelHeading}" />
                        <TextBlock Text="Requested multiplier" Style="{StaticResource PanelCaption}" />
                        <Grid x:Name="MultiplierChoices" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <ToggleButton Grid.Column="0" Content="Auto" Tag="-1" Click="OnMultiplier" HorizontalAlignment="Stretch" Padding="4,8" />
                            <ToggleButton Grid.Column="1" Content="Off" Tag="0" Click="OnMultiplier" HorizontalAlignment="Stretch" Padding="4,8" />
                            <ToggleButton Grid.Column="2" Content="2×" Tag="2" Click="OnMultiplier" HorizontalAlignment="Stretch" Padding="4,8" />
                            <ToggleButton Grid.Column="3" Content="3×" Tag="3" Click="OnMultiplier" HorizontalAlignment="Stretch" Padding="4,8" />
                            <ToggleButton Grid.Column="4" Content="4×" Tag="4" Click="OnMultiplier" HorizontalAlignment="Stretch" Padding="4,8" />
                        </Grid>
                        <TextBlock x:Name="MfgActual" Text="Start the game to verify output." FontSize="14" TextWrapping="Wrap" />
                        <TextBlock x:Name="MfgDetail" Style="{StaticResource PanelCaption}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource PanelPlate}" Background="#DD34383D">
                    <StackPanel Spacing="12">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="Neural Rendering" Style="{StaticResource PanelHeading}" VerticalAlignment="Center" />
                            <ToggleSwitch x:Name="NrEnabled" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnEdit"
                                          AutomationProperties.Name="Neural Rendering enabled" />
                        </Grid>
                        <TextBlock x:Name="NrActual" Style="{StaticResource PanelCaption}" Text="Waiting for runtime status" />
                        <Grid>
                            <TextBlock Text="Strength" FontSize="14" />
                            <TextBlock x:Name="StrengthText" Text="100%" HorizontalAlignment="Right" FontSize="14" />
                        </Grid>
                        <Slider x:Name="Strength" Minimum="0" Maximum="2" StepFrequency="0.05" Value="1" ValueChanged="OnSliderEdit"
                                AutomationProperties.Name="NR strength" />
                        <ComboBox x:Name="NrPreset" Header="Model preset" HorizontalAlignment="Stretch" SelectionChanged="OnChoiceEdit"
                                  AutomationProperties.Name="NR model preset">
                            <x:String>Automatic</x:String><x:String>Preset 1</x:String><x:String>Preset 2</x:String><x:String>Preset 3</x:String>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Expander x:Name="Advanced" Header="Advanced" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Additional controls exposed by this NR bridge." Style="{StaticResource PanelCaption}" />
                        <ToggleSwitch x:Name="PreSr" Header="Run NR before super resolution" Toggled="OnEdit" />
                        <ToggleSwitch x:Name="Cache" Header="Reuse cached NR output" Toggled="OnEdit" />
                        <NumberBox x:Name="Interval" Header="Cache interval (frames)" Minimum="1" Maximum="16" Value="1" SmallChange="1" ValueChanged="OnNumberEdit" />
                        <ComboBox x:Name="NrStyle" Header="NR style" HorizontalAlignment="Stretch" SelectionChanged="OnChoiceEdit">
                            <x:String>Style 0</x:String><x:String>Style 1</x:String><x:String>Style 2</x:String>
                        </ComboBox>
                        <TextBlock Text="Local structure" /><Slider x:Name="Structure" Minimum="0" Maximum="2" StepFrequency="0.05" Value="1" ValueChanged="OnSliderEdit" AutomationProperties.Name="Local structure" />
                        <TextBlock Text="Local tone" /><Slider x:Name="Tone" Minimum="0" Maximum="2" StepFrequency="0.05" Value="1" ValueChanged="OnSliderEdit" AutomationProperties.Name="Local tone" />
                        <ComboBox x:Name="HigherMultiplier" Header="Additional MFG multipliers" HorizontalAlignment="Stretch" SelectionChanged="OnHigherMultiplier">
                            <x:String>Use selection above</x:String><x:String>5×</x:String><x:String>6×</x:String>
                        </ComboBox>
                        <TextBlock x:Name="TelemetryText" Style="{StaticResource PanelCaption}" />
                    </StackPanel>
                </Expander>
                <Button x:Name="ClearSaved" Visibility="Collapsed" Content="Clear saved preset" Click="OnClear" HorizontalAlignment="Left" />
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Background="#E6202327" Padding="24,16,24,20">
            <StackPanel Spacing="10">
                <TextBlock x:Name="Feedback" Visibility="Collapsed" Style="{StaticResource PanelCaption}" AutomationProperties.LiveSetting="Polite" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                    <Button x:Name="ApplyLive" Content="Apply live" Click="OnApply" HorizontalAlignment="Stretch" Style="{StaticResource AccentButtonStyle}" />
                    <Button x:Name="SavePreset" Grid.Column="1" Content="Save for game" Click="OnSave" HorizontalAlignment="Stretch" />
                </Grid>
                <TextBlock x:Name="ShortcutHint" Style="{StaticResource PanelCaption}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
