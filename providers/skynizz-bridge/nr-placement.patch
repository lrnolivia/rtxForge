 namespace DlssNr
 {
+void BeginUpscalerEvaluation(bool rayReconstruction)
+{
+    // A failed upscale must not leave a pre-SR latch for the next RR frame.
+    g_preSr.ranThisFrame = false;
+    std::lock_guard lock(g_placementMutex);
+    g_placement = {};
+    g_placement.requestedBefore = EffPreSr(*Config::Instance());
+    g_placementRr = rayReconstruction;
+}
+
+void FinishUpscalerEvaluation(bool success)
+{
+    std::lock_guard lock(g_placementMutex);
+    if (!success)
+    {
+        g_placement.actual = 4; g_placement.reason = 3;
+        g_placement.modelWidth = g_placement.modelHeight = 0;
+        g_placement.reduced = false;
+    }
+    else if (!EffEnabled(*Config::Instance()))
+    {
+        g_placement.actual = 1; g_placement.reason = 0;
+        g_placement.modelWidth = g_placement.modelHeight = 0;
+        g_placement.reduced = false;
+    }
+    else if (g_placement.actual == 0)
+    {
+        g_placement.actual = 4; g_placement.reason = 4;
+    }
+    else if (g_placement.requestedBefore && g_placement.actual == 3)
+        g_placement.reason = g_placementRr ? 1 : 2;
+    g_placement.tick = GetTickCount();
+}
+
+PlacementStats GetPlacementStats()
+{
+    std::lock_guard lock(g_placementMutex);
+    return g_placement;
+}
+
