{
  "name": "rtxforge",
  "account_id": "8df30cd302a4d4a4c01db9863c712166",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "rtxforge.loew.fi",
      "custom_domain": true
    },
    {
      "pattern": "loew.fi/rtxforge*",
      "zone_name": "loew.fi"
    }
  ],
  "assets": {
    "directory": "./.site",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "main": "worker/index.mjs"
}
