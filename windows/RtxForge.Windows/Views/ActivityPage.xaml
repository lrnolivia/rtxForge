<Page
    x:Class="RtxForge.Windows.Views.ActivityPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Activity (Linux: Activity panel from the main menu) -->
    <Grid x:Name="Body" Padding="36,12,36,36" RowSpacing="16" SizeChanged="OnSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Activity" Style="{StaticResource ForgePageTitleTextStyle}" />
        <Border Grid.Row="1" Style="{StaticResource ForgeControlPodStyle}" Padding="0">
            <Grid>
                <ListView x:Name="Entries" SelectionMode="None" Padding="0,8,0,8">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel x:Name="Empty" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <FontIcon Glyph="&#xE81C;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBlock Text="No activity yet." Style="{StaticResource ForgeDimTextStyle}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
