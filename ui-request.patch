+    def animate_dialog_height(self,target,duration=240):
+        dialog=self.dialog
+        if dialog is None:return
+        try:start=int(dialog.get_content_height())
+        except Exception:start=620
+        target=int(target)
+        if start==target:
+            dialog.set_content_height(target);return
+        started=time.monotonic()
+        def tick():
+            if self.dialog is not dialog:return False
+            t=min(1.0,(time.monotonic()-started)*1000.0/max(1,duration))
+            eased=1.0-(1.0-t)**3
+            dialog.set_content_height(round(start+(target-start)*eased))
+            return t<1.0
+        GLib.timeout_add(16,tick)
