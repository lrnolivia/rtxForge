<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="GmHoverBrush" Color="Black" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="GmHoverBrush" Color="White" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="GmHoverBrush" Color="White" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!--
        Game Mode button (prototype .rf-button). Colors, radius, padding and
        font size are set per control by GameModeView from the Night / Dark /
        Light palette. Flat fills keep the artwork and selected controls prominent;
        hover respects the theme and focus follows the current game accent.
    -->
    <Style x:Key="GmButtonStyle" TargetType="Button">
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root">
                        <Canvas x:Name="GlowHost" IsHitTestVisible="False" />
                        <Grid BorderBrush="{TemplateBinding BorderBrush}"
                              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                        <Rectangle x:Name="GlowMask" Fill="{TemplateBinding Background}" IsHitTestVisible="False" />
                        <Path x:Name="GlowContour" Stretch="Fill" Fill="{TemplateBinding Background}" Visibility="Collapsed" IsHitTestVisible="False" />
                        <Border x:Name="Hover" Background="{ThemeResource GmHoverBrush}" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="Press" Background="Black" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="FocusWash" Background="{TemplateBinding FocusVisualPrimaryBrush}" Margin="{TemplateBinding FocusVisualMargin}"
                                CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False" />
                        <ContentPresenter x:Name="ContentPresenter" Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Foreground="{TemplateBinding Foreground}" />
                        <Border x:Name="GlowEdge" BorderThickness="1" Margin="1" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="FocusRing" BorderBrush="{TemplateBinding FocusVisualPrimaryBrush}" Margin="{TemplateBinding FocusVisualMargin}"
                                BorderThickness="{TemplateBinding FocusVisualPrimaryThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False" />
                        </Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters>
                                        <Setter Target="FocusRing.Opacity" Value="1" />
                                        <Setter Target="FocusWash.Opacity" Value="0.06" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Hover.Opacity" Value="0.05" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Press.Opacity" Value="0.12" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Library cards (.rf-game-card): no fill, no hover/press overlay. The
        card's own visuals (accent art stroke, accent title, art focus ring)
        are its only states, as in the approved design.
    -->
    <Style x:Key="GmBareButtonStyle" TargetType="Button">
        <Setter Property="UseSystemFocusVisuals" Value="False" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                    <ContentPresenter Content="{TemplateBinding Content}" Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                      Foreground="{TemplateBinding Foreground}" Background="Transparent" />
                        <Border x:Name="FocusRing" Margin="{TemplateBinding FocusVisualMargin}"
                                BorderBrush="{TemplateBinding FocusVisualPrimaryBrush}"
                                BorderThickness="{TemplateBinding FocusVisualPrimaryThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}" Opacity="0" IsHitTestVisible="False" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="FocusStates">
                                <VisualState x:Name="Unfocused" />
                                <VisualState x:Name="PointerFocused" />
                                <VisualState x:Name="Focused">
                                    <VisualState.Setters><Setter Target="FocusRing.Opacity" Value="1" /></VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Notes editor: native TextBox with the prototype's .rf-notes surface. -->
    <Style x:Key="GmNotesStyle" TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
