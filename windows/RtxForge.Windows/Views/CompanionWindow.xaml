<Window x:Class="RtxForge.Windows.Views.CompanionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="rtxForge overlay">
    <Grid x:Name="Root" RequestedTheme="Dark" Background="Transparent">
        <Grid.Resources>
            <FontFamily x:Key="OverlayFont">ms-appx:///Assets/Fonts/InterVariable.ttf#Inter Variable</FontFamily>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="White" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#E0FFFFFF" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="Black" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="White" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="White" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="White" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="White" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#CCCCCC" />
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="White" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="Black" />
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource OverlayFont}" />
                <Setter Property="Foreground" Value="#F4FFFFFF" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Note" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource OverlayFont}" />
                <Setter Property="Foreground" Value="#BFFFFFFF" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Section" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource OverlayFont}" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource OverlayFont}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Padding" Value="10,8" />
            </Style>
            <Style TargetType="ToggleButton">
                <Setter Property="FontFamily" Value="{StaticResource OverlayFont}" />
                <Setter Property="Background" Value="#18FFFFFF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Padding" Value="6,10" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
            <Style TargetType="Slider">
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Margin" Value="0,-5,0,0" />
            </Style>
        </Grid.Resources>
        <Border CornerRadius="20" Background="#AE080808">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Padding="26,22,26,20" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
                    <StackPanel x:Name="DragBar" Spacing="10">
                        <TextBlock Text="rtxForge" FontSize="15" FontWeight="SemiBold" Foreground="#BFFFFFFF" />
                        <TextBlock x:Name="GameName" Text="Ready when you are" FontSize="23" FontWeight="SemiBold" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="ConnectionText" Text="Start your game to connect." Style="{StaticResource Note}" />
                    </StackPanel>
                    <Button Grid.Column="1" Width="32" Height="32" VerticalAlignment="Top" Click="OnHide" AutomationProperties.Name="Hide overlay" ToolTipService.ToolTip="Back to game"><FontIcon Glyph="&#xE8BB;" FontSize="12" /></Button>
                </Grid>
                <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="Controls" Padding="26,4,26,24" Spacing="24">
                        <Border Background="#10FFFFFF" CornerRadius="12" Padding="14">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Frame generation" Style="{StaticResource Section}" />
                            <Grid x:Name="MultiplierChoices" ColumnSpacing="5">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="0" Content="Auto" Tag="-1" Click="OnMultiplier" AutomationProperties.Name="Follow game frame generation" />
                                <ToggleButton Grid.Column="1" Content="Off" Tag="0" Click="OnMultiplier" AutomationProperties.Name="Frame generation off" />
                                <ToggleButton Grid.Column="2" Content="2×" Tag="2" Click="OnMultiplier" AutomationProperties.Name="Two times frame generation" />
                                <ToggleButton Grid.Column="3" Content="3×" Tag="3" Click="OnMultiplier" AutomationProperties.Name="Three times frame generation" />
                                <ToggleButton Grid.Column="4" Content="4×" Tag="4" Click="OnMultiplier" AutomationProperties.Name="Four times frame generation" />
                            </Grid>
                            <TextBlock x:Name="MfgActual" Style="{StaticResource Note}" />
                        </StackPanel>
                        </Border>
                        <StackPanel Spacing="16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Neural rendering" Style="{StaticResource Section}" VerticalAlignment="Center" />
                                <ToggleSwitch x:Name="NrEnabled" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnEdit" AutomationProperties.Name="Neural rendering enabled" />
                            </Grid>
                            <TextBlock x:Name="NrActual" Style="{StaticResource Note}" />
                            <Grid x:Name="StyleChoices" ColumnSpacing="5">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="0" Content="Default" Tag="0" Click="OnStyle" />
                                <ToggleButton Grid.Column="1" Content="Natural" Tag="1" Click="OnStyle" />
                                <ToggleButton Grid.Column="2" Content="Cinematic" Tag="2" Click="OnStyle" />
                            </Grid>
                            <StackPanel Spacing="4">
                                <Grid><TextBlock Text="Model strength" /><TextBlock x:Name="StrengthText" HorizontalAlignment="Right" /></Grid>
                                <Slider x:Name="Strength" Minimum="0" Maximum="2" StepFrequency="0.05" Value="1" ValueChanged="OnSliderEdit" AutomationProperties.Name="NR model strength" />
                            </StackPanel>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <ComboBox x:Name="NrPreset" Header="Model preset" HorizontalAlignment="Stretch" SelectionChanged="OnChoiceEdit"><x:String>Automatic</x:String><x:String>Preset 1</x:String><x:String>Preset 2</x:String><x:String>Preset 3</x:String></ComboBox>
                                <ComboBox x:Name="Passes" Grid.Column="1" Header="Model passes" HorizontalAlignment="Stretch" SelectionChanged="OnChoiceEdit"><x:String>1 pass</x:String><x:String>2 passes</x:String><x:String>3 passes</x:String></ComboBox>
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="ImageControls" Spacing="16">
                            <TextBlock Text="Image tuning" Style="{StaticResource Section}" />
                            <StackPanel Spacing="4"><Grid><TextBlock Text="Detail" /><TextBlock x:Name="DetailText" HorizontalAlignment="Right" /></Grid><Slider x:Name="Detail" Minimum="0" Maximum="2" StepFrequency="0.05" Value="1" ValueChanged="OnSliderEdit" AutomationProperties.Name="NR detail strength" /></StackPanel>
                            <StackPanel Spacing="4"><Grid><TextBlock Text="Colour" /><TextBlock x:Name="ColourText" HorizontalAlignment="Right" /></Grid><Slider x:Name="Colour" Minimum="0" Maximum="2" StepFrequency="0.05" Value="1" ValueChanged="OnSliderEdit" AutomationProperties.Name="NR colour strength" /></StackPanel>
                            <Expander Header="Fine tuning" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="4"><Grid><TextBlock Text="Local structure" /><TextBlock x:Name="StructureText" HorizontalAlignment="Right" /></Grid><Slider x:Name="Structure" Minimum="0" Maximum="2" StepFrequency="0.05" Value="1" ValueChanged="OnSliderEdit" AutomationProperties.Name="Local structure" /></StackPanel>
                                    <StackPanel Spacing="4"><Grid><TextBlock Text="Local tone" /><TextBlock x:Name="ToneText" HorizontalAlignment="Right" /></Grid><Slider x:Name="Tone" Minimum="0" Maximum="2" StepFrequency="0.05" Value="1" ValueChanged="OnSliderEdit" AutomationProperties.Name="Local tone" /></StackPanel>
                                    <StackPanel Spacing="4"><Grid><TextBlock Text="Skin structure" /><TextBlock x:Name="SkinText" HorizontalAlignment="Right" /></Grid><Slider x:Name="Skin" Minimum="-1" Maximum="2" StepFrequency="0.05" Value="-1" ValueChanged="OnSliderEdit" AutomationProperties.Name="Skin structure, minus one follows local structure" /></StackPanel>
                                    <ToggleSwitch x:Name="AutoMask" Header="Automatic skin mask" Toggled="OnEdit" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                        <Expander x:Name="Performance" Header="Performance" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
                            <StackPanel Spacing="14">
                                <ToggleSwitch x:Name="PreSr" Header="Run before super resolution" Toggled="OnEdit" />
                                <ToggleSwitch x:Name="Reduced" Header="Use reduced model resolution" Toggled="OnEdit" />
                                <StackPanel Spacing="4"><Grid><TextBlock Text="Model resolution" /><TextBlock x:Name="ScaleText" HorizontalAlignment="Right" /></Grid><Slider x:Name="WorkScale" Minimum="0.25" Maximum="2" StepFrequency="0.01" Value="1" ValueChanged="OnSliderEdit" AutomationProperties.Name="NR model resolution" /></StackPanel>
                                <TextBlock Text="Resolution applies after SR, or with reduced resolution enabled above." Style="{StaticResource Note}" />
                                <ToggleSwitch x:Name="EdgeAware" Header="Edge-aware enlargement" Toggled="OnEdit" />
                                <ToggleSwitch x:Name="Cache" Header="Reuse NR between frames" Toggled="OnEdit" />
                                <NumberBox x:Name="Interval" Header="Run NR every N frames" Minimum="1" Maximum="16" Value="1" SmallChange="1" ValueChanged="OnNumberEdit" />
                                <TextBlock Text="Cache reuse trades fresh model output for performance. Leave it off for the tested NR + MFG setup." Style="{StaticResource Note}" />
                                <ComboBox x:Name="HigherMultiplier" Header="More FG multipliers" HorizontalAlignment="Stretch" SelectionChanged="OnHigherMultiplier"><x:String>Use selection above</x:String><x:String>5×</x:String><x:String>6×</x:String></ComboBox>
                                <TextBlock x:Name="TelemetryText" Style="{StaticResource Note}" />
                            </StackPanel>
                        </Expander>
                        <TextBlock x:Name="CompatibilityNote" Style="{StaticResource Note}" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Padding="26,16,26,22" Spacing="10">
                    <TextBlock x:Name="Feedback" Visibility="Collapsed" Style="{StaticResource Note}" AutomationProperties.LiveSetting="Polite" />
                    <Grid><Button x:Name="SavePreset" Content="Save preset" Click="OnSave" HorizontalAlignment="Left" /><Button x:Name="ClearSaved" Content="Clear saved" Click="OnClear" HorizontalAlignment="Right" Visibility="Collapsed" /></Grid>
                    <TextBlock x:Name="ShortcutHint" Style="{StaticResource Note}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
