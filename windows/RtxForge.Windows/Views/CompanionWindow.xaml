<Window x:Class="RtxForge.Windows.Views.CompanionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="rtxForge overlay">
    <Grid x:Name="Root" RequestedTheme="Dark" Background="Transparent">
        <Grid.Resources>
            <SolidColorBrush x:Key="OverlayHeadingBrush" Color="#E6E6E6" />
            <SolidColorBrush x:Key="OverlayIconBrush" Color="#C4C4C4" />
            <SolidColorBrush x:Key="OverlayGameTitleBrush" Color="#E6E6E6" />
            <FontFamily x:Key="OverlayFont">ms-appx:///Assets/Fonts/InterVariable.ttf#Inter Variable</FontFamily>
            <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#B4B4B4" />
            <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#B4B4B4" />
            <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="Black" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPointerOver" Color="#26FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#33FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#B4B4B4" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#C4C4C4" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#A4A4A4" />
            <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="#A6FFFFFF" />
            <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="#101010" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="#101010" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#101010" />
            <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="#101010" />
            <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="#80FFFFFF" />
            <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#80FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPointerOver" Color="#20FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundPressed" Color="#28FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBackgroundDisabled" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#20FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPointerOver" Color="#40FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushPressed" Color="#50FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxBorderBrushDisabled" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxForegroundDisabled" Color="#80FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxHeaderForegroundDisabled" Color="#BFFFFFFF" />
            <SolidColorBrush x:Key="ComboBoxDropDownGlyphForegroundDisabled" Color="#80FFFFFF" />
            <SolidColorBrush x:Key="ComboBoxPlaceHolderForegroundDisabled" Color="#80FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackFill" Color="#38FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackFillPointerOver" Color="#50FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackFillPressed" Color="#50FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackFillDisabled" Color="#20FFFFFF" />
            <SolidColorBrush x:Key="SliderTrackValueFill" Color="#B4B4B4" />
            <SolidColorBrush x:Key="SliderTrackValueFillPointerOver" Color="#C4C4C4" />
            <SolidColorBrush x:Key="SliderTrackValueFillDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="SliderThumbBackground" Color="#B4B4B4" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPointerOver" Color="#C4C4C4" />
            <SolidColorBrush x:Key="SliderThumbBackgroundPressed" Color="#A4A4A4" />
            <SolidColorBrush x:Key="SliderThumbBackgroundDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="SliderOuterThumbBackground" Color="Transparent" />
            <SolidColorBrush x:Key="SliderThumbBorderBrush" Color="Transparent" />
            <x:Double x:Key="SliderTrackThemeHeight">2</x:Double>
            <x:Double x:Key="SliderHorizontalThumbWidth">16</x:Double>
            <x:Double x:Key="SliderHorizontalThumbHeight">16</x:Double>
            <x:Double x:Key="SliderInnerThumbWidth">14</x:Double>
            <x:Double x:Key="SliderInnerThumbHeight">14</x:Double>
            <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#B4B4B4" />
            <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="Black" />
            <Style x:Key="SectionGlyph" TargetType="Path">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Stroke" Value="{StaticResource OverlayIconBrush}" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="Stretch" Value="Uniform" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource OverlayFont}" />
                <Setter Property="Foreground" Value="#F4FFFFFF" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style TargetType="FontIcon"><Setter Property="Foreground" Value="{StaticResource OverlayIconBrush}" /></Style>
            <Style x:Key="Note" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource OverlayFont}" />
                <Setter Property="Foreground" Value="#BFFFFFFF" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="Section" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource OverlayFont}" />
                <Setter Property="FontSize" Value="18" /><Setter Property="Foreground" Value="{StaticResource OverlayHeadingBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="FontFamily" Value="{StaticResource OverlayFont}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Padding" Value="10,8" />
            </Style>
            <Style TargetType="ToggleButton">
                <Setter Property="FontFamily" Value="{StaticResource OverlayFont}" />
                <Setter Property="Background" Value="#18FFFFFF" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Padding" Value="6,10" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource OverlayHeadingBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="#101010" />
            </Style>
            <Style TargetType="Slider">
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Margin" Value="0,-5,0,0" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource OverlayHeadingBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="#101010" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="FontFamily" Value="{StaticResource OverlayFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Background" Value="#12FFFFFF" />
                <Setter Property="BorderBrush" Value="#20FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="12,9" />
                <Setter Property="FocusVisualPrimaryBrush" Value="{StaticResource OverlayHeadingBrush}" />
                <Setter Property="FocusVisualSecondaryBrush" Value="#101010" />
            </Style>
        </Grid.Resources>
        <Border x:Name="Surface" CornerRadius="20" Background="#30080808">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Padding="26,22,26,20" ColumnSpacing="12">
                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="116" /></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="rtxForge" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource OverlayHeadingBrush}" />
                    <StackPanel x:Name="DragBar" Grid.Row="1" Grid.ColumnSpan="2" Spacing="10" Margin="0,10,0,0">
                        <TextBlock x:Name="GameName" Text="Ready when you are" Foreground="{StaticResource OverlayGameTitleBrush}" FontSize="23" FontWeight="SemiBold" MaxLines="2" TextTrimming="CharacterEllipsis" />
                        <StackPanel x:Name="PipelinePills" Orientation="Horizontal" Spacing="6" AutomationProperties.Name="Installed DLSS files" />
                        <TextBlock x:Name="ConnectionText" Text="Start your game to connect." Style="{StaticResource Note}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Top">
                        <ToggleButton x:Name="GlobalButton" Width="36" Height="36" Padding="8" Click="OnGlobal" AutomationProperties.Name="Global controls" ToolTipService.ToolTip="Switch between this game and Global controls" Foreground="{StaticResource OverlayIconBrush}"><FontIcon Glyph="&#xE774;" FontSize="16" /></ToggleButton>
                        <Button x:Name="SettingsButton" Width="36" Height="36" Click="OnSettings" AutomationProperties.Name="Overlay settings" ToolTipService.ToolTip="Overlay settings" Foreground="{StaticResource OverlayIconBrush}"><FontIcon Glyph="&#xE713;" FontSize="16" /></Button>
                        <Button Width="36" Height="36" Click="OnHide" AutomationProperties.Name="Hide overlay" ToolTipService.ToolTip="Back to game"><FontIcon Glyph="&#xE8BB;" FontSize="12" /></Button>
                    </StackPanel>
                </Grid>
                <ScrollViewer x:Name="ControlsScroll" Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="Controls" Padding="26,4,26,24" Spacing="24">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Path Style="{StaticResource SectionGlyph}" Data="M3,13 L3,3 Q3,2 4,2 L14,2 M7,6 L17,6 Q18,6 18,7 L18,17 Q18,18 17,18 L7,18 Q6,18 6,17 L6,7 Q6,6 7,6 Z" />
                                <TextBlock x:Name="MfgHeading" Text="Frame generation" Style="{StaticResource Section}" />
                            </StackPanel>
                            <Grid x:Name="MultiplierChoices" ColumnSpacing="5">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="0" Content="Auto" Tag="-1" Click="OnMultiplier" AutomationProperties.Name="Follow game frame generation" />
                                <ToggleButton Grid.Column="1" Content="Off" Tag="0" Click="OnMultiplier" AutomationProperties.Name="Frame generation off" />
                                <ToggleButton Grid.Column="2" Content="2×" Tag="2" Click="OnMultiplier" AutomationProperties.Name="Two times frame generation" />
                                <ToggleButton Grid.Column="3" Content="3×" Tag="3" Click="OnMultiplier" AutomationProperties.Name="Three times frame generation" />
                                <ToggleButton Grid.Column="4" Content="4×" Tag="4" Click="OnMultiplier" AutomationProperties.Name="Four times frame generation" />
                            </Grid>
                            <TextBlock x:Name="MfgActual" Style="{StaticResource Note}" />
                        </StackPanel>
                        <StackPanel Spacing="16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <Path Style="{StaticResource SectionGlyph}" Data="M6,4 L14,4 L18,10 L14,16 L6,16 L2,10 Z M6,4 L10,10 L14,4 M2,10 L10,10 L6,16 M18,10 L10,10 L14,16" />
                                    <TextBlock Text="Neural rendering" Style="{StaticResource Section}" />
                                </StackPanel>
                                <ToggleSwitch x:Name="NrEnabled" Grid.Column="1" OnContent="" OffContent="" MinWidth="0" Toggled="OnEdit" AutomationProperties.Name="Neural rendering enabled" />
                            </Grid>
                            <TextBlock x:Name="NrActual" Style="{StaticResource Note}" />
                            <Grid x:Name="StyleChoices" ColumnSpacing="5">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <ToggleButton Grid.Column="0" Content="Default" Tag="0" Click="OnStyle" />
                                <ToggleButton Grid.Column="1" Content="Natural" Tag="1" Click="OnStyle" />
                                <ToggleButton Grid.Column="2" Content="Cinematic" Tag="2" Click="OnStyle" />
                            </Grid>
                            <StackPanel Spacing="4">
                                <Grid><TextBlock x:Name="StrengthLabel" Text="Model strength" /><TextBlock x:Name="StrengthText" Foreground="{StaticResource OverlayHeadingBrush}" HorizontalAlignment="Right" /></Grid>
                                <Slider x:Name="Strength" Minimum="0" Maximum="2" StepFrequency="0.05" Value="1" ValueChanged="OnSliderEdit" AutomationProperties.Name="NR model strength" />
                            </StackPanel>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
                                <ComboBox x:Name="NrPreset" Header="Model preset" PlaceholderText="—" HorizontalAlignment="Stretch" SelectionChanged="OnChoiceEdit"><x:String>Automatic</x:String><x:String>Preset 1</x:String><x:String>Preset 2</x:String><x:String>Preset 3</x:String></ComboBox>
                                <ComboBox x:Name="Passes" Grid.Column="1" Header="Model passes" PlaceholderText="—" HorizontalAlignment="Stretch" SelectionChanged="OnChoiceEdit"><x:String>1 pass</x:String><x:String>2 passes</x:String><x:String>3 passes</x:String></ComboBox>
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="ImageControls" Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Path Style="{StaticResource SectionGlyph}" Data="M2,5 L5,5 M9,5 L18,5 M2,10 L11,10 M15,10 L18,10 M2,15 L5,15 M9,15 L18,15 M7,3 A2,2 0 1 0 7,7 A2,2 0 1 0 7,3 M13,8 A2,2 0 1 0 13,12 A2,2 0 1 0 13,8 M7,13 A2,2 0 1 0 7,17 A2,2 0 1 0 7,13" />
                                <TextBlock Text="Image tuning" Style="{StaticResource Section}" />
                            </StackPanel>
                            <StackPanel Spacing="4"><Grid><TextBlock x:Name="DetailLabel" Text="Detail" /><TextBlock x:Name="DetailText" Foreground="{StaticResource OverlayHeadingBrush}" HorizontalAlignment="Right" /></Grid><Slider x:Name="Detail" Minimum="0" Maximum="2" StepFrequency="0.05" Value="1" ValueChanged="OnSliderEdit" AutomationProperties.Name="NR detail strength" /></StackPanel>
                            <StackPanel Spacing="4"><Grid><TextBlock x:Name="ColourLabel" Text="Colour" /><TextBlock x:Name="ColourText" Foreground="{StaticResource OverlayHeadingBrush}" HorizontalAlignment="Right" /></Grid><Slider x:Name="Colour" Minimum="0" Maximum="2" StepFrequency="0.05" Value="1" ValueChanged="OnSliderEdit" AutomationProperties.Name="NR colour strength" /></StackPanel>
                            <Expander Header="Fine tuning" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
                                <StackPanel Spacing="12">
                                    <StackPanel Spacing="4"><Grid><TextBlock Text="Local structure" /><TextBlock x:Name="StructureText" Foreground="{StaticResource OverlayHeadingBrush}" HorizontalAlignment="Right" /></Grid><Slider x:Name="Structure" Minimum="0" Maximum="2" StepFrequency="0.05" Value="1" ValueChanged="OnSliderEdit" AutomationProperties.Name="Local structure" /></StackPanel>
                                    <StackPanel Spacing="4"><Grid><TextBlock Text="Local tone" /><TextBlock x:Name="ToneText" Foreground="{StaticResource OverlayHeadingBrush}" HorizontalAlignment="Right" /></Grid><Slider x:Name="Tone" Minimum="0" Maximum="2" StepFrequency="0.05" Value="1" ValueChanged="OnSliderEdit" AutomationProperties.Name="Local tone" /></StackPanel>
                                    <StackPanel Spacing="4"><Grid><TextBlock Text="Skin structure" /><TextBlock x:Name="SkinText" Foreground="{StaticResource OverlayHeadingBrush}" HorizontalAlignment="Right" /></Grid><Slider x:Name="Skin" Minimum="-1" Maximum="2" StepFrequency="0.05" Value="-1" ValueChanged="OnSliderEdit" AutomationProperties.Name="Skin structure, minus one follows local structure" /></StackPanel>
                                    <ToggleSwitch x:Name="AutoMask" Header="Automatic skin mask" Toggled="OnEdit" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                        <Expander x:Name="SharpeningGroup" Header="Sharpening" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
                        <StackPanel Spacing="12">
                            <ToggleSwitch x:Name="SharpEnabled" Header="Enable filter" Toggled="OnEdit" AutomationProperties.Name="OptiScaler sharpening enabled" />
                            <TextBlock Text="The same OptiScaler filter used by your rtxForge presets." Style="{StaticResource Note}" />
                            <ComboBox x:Name="SharpFilter" Header="Filter" PlaceholderText="—" HorizontalAlignment="Stretch" SelectionChanged="OnChoiceEdit"><x:String>RCAS</x:String><x:String>Depth aware</x:String><x:String>Local contrast depth aware</x:String></ComboBox>
                            <ToggleSwitch x:Name="SharpOverride" Header="Override game sharpening" Toggled="OnEdit" />
                            <StackPanel Spacing="4"><Grid><TextBlock Text="Strength" /><TextBlock x:Name="SharpnessText" Foreground="{StaticResource OverlayHeadingBrush}" HorizontalAlignment="Right" /></Grid><Slider x:Name="Sharpness" Minimum="0" Maximum="1" StepFrequency="0.01" Value="0.5" ValueChanged="OnSliderEdit" AutomationProperties.Name="OptiScaler sharpening strength" /></StackPanel>
                            <Expander Header="Motion sharpening" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0">
                                <StackPanel Spacing="12"><ToggleSwitch x:Name="MotionSharpEnabled" Header="Sharpen moving detail" Toggled="OnEdit" /><StackPanel Spacing="4"><Grid><TextBlock Text="Motion strength" /><TextBlock x:Name="MotionSharpnessText" Foreground="{StaticResource OverlayHeadingBrush}" HorizontalAlignment="Right" /></Grid><Slider x:Name="MotionSharpness" Minimum="0" Maximum="1" StepFrequency="0.01" Value="0.2" ValueChanged="OnSliderEdit" AutomationProperties.Name="Motion sharpening strength" /></StackPanel></StackPanel>
                            </Expander>
                        </StackPanel>
                        </Expander>
                        <Expander x:Name="Performance" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0" CornerRadius="8">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Path Style="{StaticResource SectionGlyph}" Width="18" Height="18" Data="M3,16 A8,8 0 1 1 17,16 M10,3 L10,5 M3,8 L5,9 M17,8 L15,9 M10,13 L14,7 M8,16 L12,16" />
                                    <TextBlock Text="Performance" FontSize="13" />
                                </StackPanel>
                            </Expander.Header>
                            <StackPanel Spacing="14">
                                <ToggleSwitch x:Name="PreSr" Header="Run before super resolution" Toggled="OnEdit" />
                                <ToggleSwitch x:Name="Reduced" Header="Use reduced model resolution" Toggled="OnEdit" />
                                <StackPanel Spacing="4"><Grid><TextBlock Text="Model resolution" /><TextBlock x:Name="ScaleText" Foreground="{StaticResource OverlayHeadingBrush}" HorizontalAlignment="Right" /></Grid><Slider x:Name="WorkScale" Minimum="0.25" Maximum="2" StepFrequency="0.01" Value="1" ValueChanged="OnSliderEdit" AutomationProperties.Name="NR model resolution" /></StackPanel>
                                <TextBlock Text="Resolution applies after SR, or with reduced resolution enabled above." Style="{StaticResource Note}" />
                                <ToggleSwitch x:Name="EdgeAware" Header="Edge-aware enlargement" Toggled="OnEdit" />
                                <ToggleSwitch x:Name="Cache" Header="Reuse NR between frames" Toggled="OnEdit" />
                                <NumberBox x:Name="Interval" Header="Run NR every N frames" PlaceholderText="—" Minimum="1" Maximum="16" Value="1" SmallChange="1" ValueChanged="OnNumberEdit" />
                                <TextBlock Text="Cache reuse trades fresh model output for performance. Leave it off for the tested NR + MFG setup." Style="{StaticResource Note}" />
                                <ComboBox x:Name="HigherMultiplier" Header="More FG multipliers" PlaceholderText="—" HorizontalAlignment="Stretch" SelectionChanged="OnHigherMultiplier"><x:String>Use selection above</x:String><x:String>5×</x:String><x:String>6×</x:String></ComboBox>
                                <TextBlock x:Name="TelemetryText" Style="{StaticResource Note}" />
                            </StackPanel>
                        </Expander>
                        <TextBlock x:Name="CompatibilityNote" Style="{StaticResource Note}" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="SettingsScroll" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="26,4,26,24" Spacing="24">
                        <Grid>
                            <TextBlock Text="Overlay settings" Style="{StaticResource Section}" VerticalAlignment="Center" />
                            <Button x:Name="BackToControls" Content="Done" Click="OnSettings" HorizontalAlignment="Right" Foreground="{StaticResource OverlayHeadingBrush}" AutomationProperties.Name="Back to overlay controls" />
                        </Grid>
                        <StackPanel x:Name="SettingsHost" />
                    </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="GlobalScroll" Grid.Row="1" Grid.RowSpan="2" Visibility="Collapsed" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Padding="26,4,26,24" Spacing="20">
                        <TextBlock Text="Global controls" Style="{StaticResource Section}" />
                        <StackPanel x:Name="GlobalHost" />
                    </StackPanel>
                </ScrollViewer>
                <StackPanel x:Name="PresetFooter" Grid.Row="2" Padding="26,16,26,22" Spacing="10">
                    <TextBlock x:Name="Feedback" Visibility="Collapsed" Style="{StaticResource Note}" AutomationProperties.LiveSetting="Polite" />
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button x:Name="SavePreset" Content="Save preset" Click="OnSave" HorizontalAlignment="Stretch" Height="44" Background="{StaticResource AccentFillColorDefaultBrush}" Foreground="#101010" FontWeight="SemiBold">
                            <Button.Resources>
                                <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#C4C4C4" /><SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#A4A4A4" />
                                <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="#101010" /><SolidColorBrush x:Key="ButtonForegroundPressed" Color="#101010" />
                            </Button.Resources>
                        </Button>
                        <Button x:Name="ClearSaved" Grid.Column="1" Content="Reset" Click="OnClear" HorizontalAlignment="Stretch" Height="44" Background="#B92E39" Foreground="White" ToolTipService.ToolTip="Reset live controls to this game's installed settings and clear its saved overlay preset.">
                            <Button.Resources><SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#CB3B47" /><SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#9C2430" /></Button.Resources>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="ShortcutHint" Style="{StaticResource Note}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
