<Page
    x:Class="RtxForge.Windows.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    SizeChanged="OnPageSizeChanged">

    <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <!-- Left-aligned and full width with responsive margins, like the other pages. -->
        <StackPanel x:Name="Body" Padding="36,12,36,48">
            <TextBlock Text="Settings" Style="{StaticResource ForgePageTitleTextStyle}" Margin="0,0,0,4" />
            <ScrollViewer HorizontalScrollMode="Enabled" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                <StackPanel x:Name="SectionGroups" Orientation="Horizontal" Spacing="20" Margin="0,8,0,0" />
            </ScrollViewer>
            <InfoBar x:Name="Notice" IsOpen="False" Severity="Warning" IsClosable="True" Margin="0,8,0,0" />
            <StackPanel x:Name="PageHost" />
        </StackPanel>
    </ScrollViewer>
</Page>
